<Window x:Class="RfidVehicleAccess.PaymentConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iTOLL Automation - Payment Configuration"
        Icon="pack://application:,,,/Assets/RealTechiTollAutomation.ico"
        Width="780"
        Height="570"
        MinWidth="650"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Vehicle Category Payment Configuration"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#0F172A" />

        <TextBlock Grid.Row="1"
                   Margin="0,7,0,14"
                   Foreground="#475569"
                   TextWrapping="Wrap"
                   Text="Create a category for each vehicle capacity and set its IN entry price. Vehicles receive a category through the vehicle import column. A vehicle with a blank or unmatched category uses the selected default category." />

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Text="Default category"
                           FontWeight="SemiBold"
                           Foreground="#1E293B" />
                <ComboBox x:Name="DefaultCategoryComboBox"
                          Grid.Column="1"
                          Height="34"
                          Padding="7,3"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDefaultCategory, Mode=TwoWay}" />
                <Button Grid.Column="3"
                        Width="116"
                        Height="34"
                        Margin="12,0,8,0"
                        Content="Add Category"
                        Click="AddCategory_Click" />
                <Button Grid.Column="4"
                        Width="130"
                        Height="34"
                        Content="Delete Selected"
                        Click="DeleteSelected_Click" />
            </Grid>
        </Border>

        <DataGrid x:Name="CategoryDataGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding Categories}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#F8FAFC"
                  Background="White"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vehicle Category / Capacity"
                                    Width="*"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Payment Price (Rs)"
                                    Width="190"
                                    Binding="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,0"
                   Foreground="#64748B"
                   TextWrapping="Wrap"
                   Text="Example: 10000 Liter Capacity = 1000.00 Rs; 6000 Liter Capacity = 600.00 Rs. FREE RFID cards are always charged 0.00 Rs." />

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationTextBlock"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="#B91C1C"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Content="Cancel"
                        IsCancel="True" />
                <Button Width="130"
                        Height="38"
                        Content="Save Prices"
                        IsDefault="True"
                        Click="Save_Click"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
