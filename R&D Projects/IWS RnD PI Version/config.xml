<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>

    <!-- ================== SERIAL SETTINGS ================== -->
    <!-- RFID Readers -->
    <add key="rfidInBaudRate" value="9600"/>
    <add key="rfidOutBaudRate" value="9600"/>
    <!-- On Raspberry Pi, use /dev/ttyUSB* or /dev/ttyS* -->
    <add key="rfidInCOMport" value="/dev/ttyUSB0"/>
    <add key="rfidOutCOMport" value="/dev/ttyUSB1"/>

    <!-- Weight Scale -->
    <add key="wsBaudRate" value="9600"/>
    <add key="wsCOMport" value="/dev/ttyUSB2"/>

    <!-- ================== FTP / SERVER ================== -->
    <add key="ftpHost" value="192.168.1.10"/>
    <add key="ftpPort" value="21"/>
    <add key="ftpUser" value="ftpuser"/>
    <add key="ftpPassword" value="ftppassword"/>
    <add key="ftpPath" value="/weighbridge"/>

    <!-- ================== SITE / NAMING ================== -->
    <add key="siteName" value="PVT AWS SITE 01"/>
    <add key="imgPrefix" value="AWS_"/>

    <!-- ================== TIMINGS (SECONDS) ================== -->
    <!-- RFID must be detected continuously for this long -->
    <add key="rfidTriggerDurationSec" value="10"/>
    <!-- Wait after vehicle detected on bridge before closing IN barrier -->
    <add key="bridgeWaitTime" value="25"/>
    <!-- After processing + printing, wait before opening OUT barrier -->
    <add key="postProcessGoDelaySec" value="10"/>
    <!-- How long we check for stable low weight before closing OUT barrier -->
    <add key="outBarrierCloseDelaySec" value="15"/>

    <!-- ================== WEIGHTS / TOLERANCES (KG) ================== -->
    <!-- Minimum loaded weight to consider a valid load -->
    <add key="minWeightKg" value="1000"/>
    <!-- For loaded weight stabilization (IN) -->
    <add key="stableToleranceIn" value="100"/>
    <add key="stableTimeInSec" value="15"/>
    <!-- For empty weight stabilization (OUT) -->
    <add key="stableToleranceOut" value="50"/>
    <add key="stableTimeOutSec" value="10"/>
    <!-- When weight is within this range, system considered READY -->
    <add key="readyToleranceKg" value="50"/>

    <!-- ================== PATHS ================== -->
    <!-- Relative to the Python script directory -->
    <add key="snapshotPath" value="data/images"/>
    <add key="audioPath" value="data/audio"/>

    <!-- ================== CAMERAS (RTSP) ================== -->
    <add key="camera1Url" value="rtsp://admin:Admin%4012@192.168.22.221:554/h264/ch1/main/av_stream"/>
    <add key="camera2Url" value="rtsp://admin:Admin%4012@192.168.22.222:554/h264/ch1/main/av_stream"/>
    <add key="camera3Url" value="rtsp://admin:Admin%4012@192.168.22.223:554/h264/ch1/main/av_stream"/>
    <add key="camera4Url" value="rtsp://admin:Admin%4012@192.168.22.224:554/h264/ch1/main/av_stream"/>

  </appSettings>
</configuration>
