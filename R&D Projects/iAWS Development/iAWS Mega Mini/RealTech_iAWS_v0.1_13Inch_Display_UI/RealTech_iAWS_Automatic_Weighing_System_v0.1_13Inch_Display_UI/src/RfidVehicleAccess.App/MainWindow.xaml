<Window x:Class="RfidVehicleAccess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RfidVehicleAccess.Models"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="RealTech iAWS - Automatic Weighing System v0.1"
        Icon="Assets/RealTechiAWS.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="640"
        Background="#EAF0F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Fixed 13-inch display card styling -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CameraStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="LIVE">
                    <Setter Property="Foreground" Value="#4ADE80"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E8F1FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact traffic signal lamps for 13-inch dashboard -->
        <Style x:Key="RedSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#35202A"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Red}">
                    <Setter Property="Fill" Value="#EF4444"/>
                    <Setter Property="Stroke" Value="#FCA5A5"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#EF4444" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrangeSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#3B2A22"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Orange}">
                    <Setter Property="Fill" Value="#F59E0B"/>
                    <Setter Property="Stroke" Value="#FCD34D"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F59E0B" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#183329"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Green}">
                    <Setter Property="Fill" Value="#22D36B"/>
                    <Setter Property="Stroke" Value="#A7F3D0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#22D36B" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarrierText" TargetType="TextBlock">
            <Setter Property="Text" Value="CLOSED"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="OPEN"/>
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        13-inch fixed-display baseline:
        30px menu + minimum 300px camera/system row + minimum 210px lane row + flexible logs + 22px footer.
        This keeps every operational control visible on common 1366x768 13-inch panels,
        including Windows display scaling, without changing any iAWS processing logic.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="2.8*" MinHeight="300"/>
            <RowDefinition Height="1.9*" MinHeight="210"/>
            <RowDefinition Height="1.0*" MinHeight="65"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- MENU -->
        <Menu Grid.Row="0" Background="#0F172A" Foreground="White" Padding="4,0" VerticalContentAlignment="Center">
            <MenuItem Header="File" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Open Image Folder" Command="{Binding OpenCaptureFolderCommand}" Style="{StaticResource SubMenuItemStyle}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Configuration" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Weighbridge / COM / Hardware" Click="OpenHardwareSettings_Click" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Server Panel - Weight / Cameras / Server" Click="OpenServerPanel_Click" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Data" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Import Vehicles" Command="{Binding ImportVehiclesCommand}" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Import Vehicles from API" Command="{Binding ImportVehiclesFromApiCommand}" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Control Panel" Style="{StaticResource TopMenuItemStyle}" Click="OpenAdminControls_Click"/>
            <MenuItem Header="About" Style="{StaticResource TopMenuItemStyle}" Click="OpenAbout_Click"/>
        </Menu>

        <!-- TOP: 4 CAMERAS + SYSTEM INFORMATION -->
        <Grid Grid.Row="1" Margin="7,5,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Four editable cameras -->
            <Grid Grid.Column="0" Margin="0,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera1VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="CAMERA 1" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding InCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera2VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="CAMERA 2" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding OutCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera3VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="CAMERA 3" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera3Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera4VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="CAMERA 4" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera4Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right-side information panel: fixed row heights prevent clipping -->
            <Grid Grid.Column="1" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Branding -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="7,4" BorderBrush="#94A3B8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/RealTechiAWSLogo.png" Stretch="Uniform" Margin="1"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="RealTech iAWS" FontSize="19" FontWeight="ExtraBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="AUTOMATIC WEIGHING SYSTEM" FontSize="8.5" FontWeight="Bold" Foreground="#F97316" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="v0.1" FontSize="9" FontWeight="ExtraBold" Foreground="#16A34A"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Date / time -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DATE" FontSize="8" Foreground="#64748B" FontWeight="ExtraBold"/>
                            <TextBlock Text="{Binding SystemDate}" FontSize="13" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TIME" FontSize="8" Foreground="#64748B" FontWeight="ExtraBold"/>
                                <TextBlock Text="{Binding SystemTime}" FontSize="13" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Processed / pending -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="3,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PROCESSED" FontSize="8" FontWeight="ExtraBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="{Binding ProcessedRecords}" Foreground="#15803D" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PENDING" FontSize="8" FontWeight="ExtraBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="{Binding PendingRecords}" Foreground="#B91C1C" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Connectivity -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="7,4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="INTERNET / SERVER" FontSize="8.5" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding NetworkStatus}" TextWrapping="Wrap" FontSize="9.5" Foreground="#334155" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ServerStatus}" TextWrapping="Wrap" FontSize="8.2" Foreground="#334155" Margin="0,1,0,0" MaxHeight="22" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="7,4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HARDWARE COM" FontSize="8.5" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding ActiveControlTransport}" FontSize="9.5" FontWeight="ExtraBold" Foreground="#1D4ED8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding HardwareStatus}" TextWrapping="Wrap" FontSize="8" Foreground="#475569" MaxHeight="22" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Live weight -->
                <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="6,3" BorderBrush="#334155" BorderThickness="1.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LIVE WEIGHT" Style="{StaticResource SectionHeader}" FontSize="10"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LiveWeight}" FontSize="31" FontWeight="ExtraBold" Foreground="#16A34A" HorizontalAlignment="Center" LineHeight="31"/>
                            <TextBlock Text="{Binding TargetWeight}" FontSize="10.5" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WeightProcessStatus}" FontSize="8.5" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding WeighbridgeStatus}" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- SHARED WEIGHBRIDGE DIRECTION: FIRST RFID WINS -->
        <Grid Grid.Row="2" Margin="7,2,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IN LANE -->
            <Border Grid.Column="0" Background="White" BorderBrush="#7FA9E8" BorderThickness="1.5" CornerRadius="9" Margin="3,0,3,0" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#2563EB" BorderThickness="2.5" CornerRadius="7" Background="#EFF6FF" Padding="9,3" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IN RFID" FontSize="17" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding InRfid}" FontSize="16" FontWeight="ExtraBold" Foreground="#1D4ED8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal and buzzer -->
                        <Border Grid.Column="0" BorderBrush="#D6E0EC" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="5" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIGNAL" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Width="44" Height="74" CornerRadius="14" Background="#111827" BorderBrush="#475569" BorderThickness="2" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding InSignalState}"/>
                                        <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding InSignalState}"/>
                                        <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding InSignalState}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="3,1" Margin="3,1,3,0" Tag="{Binding IsInBuzzerActive}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F1E5C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0C2"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="BUZZER" FontSize="7" FontWeight="ExtraBold" Foreground="#A16207" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="🔔" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center" Tag="{Binding IsInBuzzerActive}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7A64A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#F59E0B" BlurRadius="7" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- IN barrier. Larger internal drawing area prevents the raised arm from clipping. -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1.5" Padding="5" Tag="{Binding IsInBarrierOpen}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF9F9"/>
                                    <Setter Property="BorderBrush" Value="#F1A2A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#F5FFF8"/>
                                            <Setter Property="BorderBrush" Value="#86D8A2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="13"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="IN BARRIER" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="3,0">
                                    <Canvas Width="190" Height="110" ClipToBounds="False">
                                        <Rectangle Width="14" Height="40" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="18" Canvas.Top="64"/>
                                        <Rectangle Width="28" Height="7" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="11" Canvas.Top="100"/>
                                        <Ellipse Width="16" Height="16" Fill="#56657A" Stroke="#263345" StrokeThickness="2" Canvas.Left="17" Canvas.Top="82"/>
                                        <Ellipse Width="5" Height="5" Fill="White" Canvas.Left="22.5" Canvas.Top="87.5"/>
                                        <Grid Width="112" Height="10" Canvas.Left="30" Canvas.Top="85" RenderTransformOrigin="0,0.5" Tag="{Binding IsInBarrierOpen}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-48"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.65"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="6" Background="#E52B2F" CornerRadius="2" BorderBrush="#BB1F24" BorderThickness="1"/>
                                            <Rectangle Grid.Column="1" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="3" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="5" Fill="White" Margin="0,1"/>
                                        </Grid>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="2" Style="{StaticResource BarrierText}" Tag="{Binding IsInBarrierOpen}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="3,2,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding InAccessStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="7,1" Margin="7,0,0,0">
                            <TextBlock Text="{Binding InVehicleNumber}" FontWeight="ExtraBold" FontSize="9" Foreground="#0F172A"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- OUT LANE -->
            <Border Grid.Column="1" Background="White" BorderBrush="#A99BEF" BorderThickness="1.5" CornerRadius="9" Margin="3,0,3,0" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#7C3AED" BorderThickness="2.5" CornerRadius="7" Background="#F5F3FF" Padding="9,3" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OUT RFID" FontSize="17" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutRfid}" FontSize="16" FontWeight="ExtraBold" Foreground="#7C3AED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal and buzzer -->
                        <Border Grid.Column="0" BorderBrush="#D6E0EC" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="5" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIGNAL" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Width="44" Height="74" CornerRadius="14" Background="#111827" BorderBrush="#475569" BorderThickness="2" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding OutSignalState}"/>
                                        <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding OutSignalState}"/>
                                        <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding OutSignalState}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="3,1" Margin="3,1,3,0" Tag="{Binding IsOutBuzzerActive}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F1E5C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0C2"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="BUZZER" FontSize="7" FontWeight="ExtraBold" Foreground="#A16207" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="🔔" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center" Tag="{Binding IsOutBuzzerActive}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7A64A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#F59E0B" BlurRadius="7" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- OUT barrier -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1.5" Padding="5" Tag="{Binding IsOutBarrierOpen}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF9F9"/>
                                    <Setter Property="BorderBrush" Value="#F1A2A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#F5FFF8"/>
                                            <Setter Property="BorderBrush" Value="#86D8A2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="13"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="OUT BARRIER" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="3,0">
                                    <Canvas Width="190" Height="110" ClipToBounds="False">
                                        <Rectangle Width="14" Height="40" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="18" Canvas.Top="64"/>
                                        <Rectangle Width="28" Height="7" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="11" Canvas.Top="100"/>
                                        <Ellipse Width="16" Height="16" Fill="#56657A" Stroke="#263345" StrokeThickness="2" Canvas.Left="17" Canvas.Top="82"/>
                                        <Ellipse Width="5" Height="5" Fill="White" Canvas.Left="22.5" Canvas.Top="87.5"/>
                                        <Grid Width="112" Height="10" Canvas.Left="30" Canvas.Top="85" RenderTransformOrigin="0,0.5" Tag="{Binding IsOutBarrierOpen}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-48"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.65"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="6" Background="#E52B2F" CornerRadius="2" BorderBrush="#BB1F24" BorderThickness="1"/>
                                            <Rectangle Grid.Column="1" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="3" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="5" Fill="White" Margin="0,1"/>
                                        </Grid>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="2" Style="{StaticResource BarrierText}" Tag="{Binding IsOutBarrierOpen}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="3,2,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OutAccessStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="7,1" Margin="7,0,0,0">
                            <TextBlock Text="{Binding OutVehicleNumber}" FontWeight="ExtraBold" FontSize="9" Foreground="#0F172A"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- LOGS -->
        <Grid Grid.Row="3" Margin="7,2,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="3" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="9,3">
                        <TextBlock Text="SERVER LOG" FontSize="9.5" FontWeight="ExtraBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ServerLogs}" FontFamily="Consolas" FontSize="8.7" BorderThickness="0" Background="White" Padding="4,2"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="3" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="9,3">
                        <TextBlock Text="STATUS LOG" FontSize="9.5" FontWeight="ExtraBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding StatusLogs}" FontFamily="Consolas" FontSize="8.7" BorderThickness="0" Background="White" Padding="4,2"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="#0F172A" Padding="8,2">
            <DockPanel LastChildFill="True">
                <TextBlock Text="RealTech iAWS v0.1  •  SINGLE WEIGHBRIDGE  •  FIRST RFID WINS  •  4 EDITABLE CAMERAS" Foreground="#E2E8F0" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProcessedRecords, StringFormat='Processed Today: {0}'}" Foreground="#A7F3D0" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="9"/>
                <TextBlock Text="{Binding PendingRecords, StringFormat='Pending Sync: {0}'}" Foreground="#FDE68A" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="9"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
