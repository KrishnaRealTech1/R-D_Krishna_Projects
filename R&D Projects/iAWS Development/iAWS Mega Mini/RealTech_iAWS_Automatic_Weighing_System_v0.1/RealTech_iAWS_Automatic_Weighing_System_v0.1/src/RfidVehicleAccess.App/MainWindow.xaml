<Window x:Class="RfidVehicleAccess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RfidVehicleAccess.Models"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="RealTech iAWS - Automatic Weighing System v0.1"
        Icon="Assets/RealTechiAWS.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1280"
        MinHeight="800"
        Background="#F4F5F7">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style x:Key="CameraStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="LIVE">
                    <Setter Property="Foreground" Value="#4ADE80"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Fill" Value="#4B1515"/>
            <Setter Property="Stroke" Value="#111827"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Red}">
                    <Setter Property="Fill" Value="#EF4444"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrangeSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Fill" Value="#59340A"/>
            <Setter Property="Stroke" Value="#111827"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Orange}">
                    <Setter Property="Fill" Value="#F59E0B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GreenSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Fill" Value="#123922"/>
            <Setter Property="Stroke" Value="#111827"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Green}">
                    <Setter Property="Fill" Value="#22C55E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BuzzerText" TargetType="TextBlock">
            <Setter Property="Text" Value="BUZZER OFF"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="BUZZER ON"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BarrierText" TargetType="TextBlock">
            <Setter Property="Text" Value="BOOM CLOSED"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="BOOM OPEN"/>
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3.2*"/>
            <RowDefinition Height="2.0*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#111827" Foreground="White" Padding="4,2">
            <MenuItem Header="File" Foreground="White">
                <MenuItem Header="Open Image Folder" Command="{Binding OpenCaptureFolderCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Configuration" Foreground="White">
                <MenuItem Header="Weighbridge / COM / Hardware" Click="OpenHardwareSettings_Click"/>
                <MenuItem Header="Server Panel - Weight / Cameras / Server" Click="OpenServerPanel_Click"/>
            </MenuItem>
            <MenuItem Header="Data" Foreground="White">
                <MenuItem Header="Import Vehicles" Command="{Binding ImportVehiclesCommand}"/>
                <MenuItem Header="Import Vehicles from API" Command="{Binding ImportVehiclesFromApiCommand}"/>
            </MenuItem>
            <MenuItem Header="Control Panel" Foreground="White" Click="OpenAdminControls_Click"/>
            <MenuItem x:Name="AboutVersionMenuItem" Header="RealTech iAWS v0.1" Foreground="White"/>
        </Menu>

        <!-- Top area: 4 cameras + the right-side information column from the hand-drawn layout. -->
        <Grid Grid.Row="1" Margin="6,4,6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.35*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#090F17" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera1VideoView"/>
                        <Border VerticalAlignment="Top" Background="#B0000000" Padding="8,4">
                            <DockPanel>
                                <TextBlock Text="CAMERA 1" Foreground="White" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding InCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#090F17" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera2VideoView"/>
                        <Border VerticalAlignment="Top" Background="#B0000000" Padding="8,4">
                            <DockPanel>
                                <TextBlock Text="CAMERA 2" Foreground="White" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding OutCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#090F17" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera3VideoView"/>
                        <Border VerticalAlignment="Top" Background="#B0000000" Padding="8,4">
                            <DockPanel>
                                <TextBlock Text="CAMERA 3" Foreground="White" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera3Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#090F17" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera4VideoView"/>
                        <Border VerticalAlignment="Top" Background="#B0000000" Padding="8,4">
                            <DockPanel>
                                <TextBlock Text="CAMERA 4" Foreground="White" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera4Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.1*"/>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="0.9*"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/RealTechiAWSLogo.png" Stretch="Uniform" Margin="2"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="RealTech iAWS" FontSize="24" FontWeight="ExtraBold" Foreground="#111827"/>
                            <TextBlock Text="AUTOMATIC WEIGHING SYSTEM" FontSize="11" FontWeight="Bold" Foreground="#F97316"/>
                            <TextBlock Text="v0.1" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DATE" FontSize="11" Foreground="#6B7280" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SystemDate}" FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TIME" FontSize="11" Foreground="#6B7280" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SystemTime}" FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="INTERNET / SERVER" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NetworkStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ServerStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HARDWARE COM" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ActiveControlTransport}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding HardwareStatus}" TextWrapping="Wrap" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="10" BorderThickness="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="WEIGHT DATA" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding LiveWeight}" FontSize="38" FontWeight="ExtraBold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,4"/>
                        <TextBlock Text="{Binding TargetWeight}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WeightProcessStatus}" FontSize="11" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,2"/>
                        <TextBlock Text="{Binding WeighbridgeStatus}" FontSize="10" Foreground="#4B5563" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- IN and OUT share the same physical weighbridge; first RFID after target wins. -->
        <Grid Grid.Row="2" Margin="6,2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" BorderThickness="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#9CA3AF" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IN RFID" FontSize="20" FontWeight="ExtraBold" Margin="0,0,30,0"/>
                            <TextBlock Text="{Binding InRfid}" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding InSignalState}"/>
                            <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding InSignalState}"/>
                            <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding InSignalState}"/>
                            <TextBlock Text="IN SIGNAL" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="95" Height="70" BorderBrush="#374151" BorderThickness="2" CornerRadius="5" Background="#F3F4F6">
                                <TextBlock Text="IN&#x0a;BUZZER" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Style="{StaticResource BuzzerText}" Tag="{Binding IsInBuzzerActive}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding InAccessStatus}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="190" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="190" Height="85">
                                <Rectangle Width="20" Height="75" Fill="#4B5563" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Rectangle Width="145" Height="13" Fill="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource BarrierText}" Tag="{Binding IsInBarrierOpen}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding InVehicleNumber}" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" BorderThickness="2" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#9CA3AF" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OUT RFID" FontSize="20" FontWeight="ExtraBold" Margin="0,0,30,0"/>
                            <TextBlock Text="{Binding OutRfid}" FontSize="18" FontWeight="Bold" Foreground="#7C3AED"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding OutSignalState}"/>
                            <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding OutSignalState}"/>
                            <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding OutSignalState}"/>
                            <TextBlock Text="OUT SIGNAL" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="95" Height="70" BorderBrush="#374151" BorderThickness="2" CornerRadius="5" Background="#F3F4F6">
                                <TextBlock Text="OUT&#x0a;BUZZER" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Style="{StaticResource BuzzerText}" Tag="{Binding IsOutBuzzerActive}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding OutAccessStatus}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="190" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="190" Height="85">
                                <Rectangle Width="20" Height="75" Fill="#4B5563" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                <Rectangle Width="145" Height="13" Fill="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource BarrierText}" Tag="{Binding IsOutBarrierOpen}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding OutVehicleNumber}" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="6,2,6,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="SERVER LOG" Margin="4">
                <ListBox ItemsSource="{Binding ServerLogs}" FontFamily="Consolas" FontSize="10"/>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="STATUS LOG" Margin="4">
                <ListBox ItemsSource="{Binding StatusLogs}" FontFamily="Consolas" FontSize="10"/>
            </GroupBox>
        </Grid>

        <Border Grid.Row="4" Background="#111827" Padding="8,4">
            <DockPanel>
                <TextBlock Text="RealTech iAWS v0.1 | SINGLE WEIGHBRIDGE | FIRST RFID WINS | 4 EDITABLE CAMERAS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="{Binding ProcessedRecords, StringFormat='Processed Today: {0}'}" Foreground="#D1FAE5" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="18,0,0,0"/>
                <TextBlock Text="{Binding PendingRecords, StringFormat='Pending Sync: {0}'}" Foreground="#FDE68A" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
