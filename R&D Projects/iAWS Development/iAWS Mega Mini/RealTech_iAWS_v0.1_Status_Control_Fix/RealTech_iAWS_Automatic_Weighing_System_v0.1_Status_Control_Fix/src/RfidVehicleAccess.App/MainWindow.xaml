<Window x:Class="RfidVehicleAccess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RfidVehicleAccess.Models"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="RealTech iAWS - Automatic Weighing System v0.1"
        Icon="Assets/RealTechiAWS.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="960"
        MinHeight="620"
        Background="#EAF0F6">
    <Window.Resources>
        <!-- Shared card styling -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CameraStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="LIVE">
                    <Setter Property="Foreground" Value="#4ADE80"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Top menu items stay white on the dark bar. -->
        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sub-menu text is explicitly dark so it is always visible on the white popup. -->
        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E8F1FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Signal light styles -->
        <Style x:Key="RedSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#35202A"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Red}">
                    <Setter Property="Fill" Value="#EF4444"/>
                    <Setter Property="Stroke" Value="#FCA5A5"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#EF4444" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrangeSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#3B2A22"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Orange}">
                    <Setter Property="Fill" Value="#F59E0B"/>
                    <Setter Property="Stroke" Value="#FCD34D"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#183329"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Green}">
                    <Setter Property="Fill" Value="#22D36B"/>
                    <Setter Property="Stroke" Value="#A7F3D0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#22D36B" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarrierText" TargetType="TextBlock">
            <Setter Property="Text" Value="CLOSED"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="OPEN"/>
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="3.0*"/>
            <RowDefinition Height="2.05*"/>
            <RowDefinition Height="1.15*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- MENU -->
        <Menu Grid.Row="0" Background="#0F172A" Foreground="White" Padding="4,0" VerticalContentAlignment="Center">
            <MenuItem Header="File" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Open Image Folder" Command="{Binding OpenCaptureFolderCommand}" Style="{StaticResource SubMenuItemStyle}"/>
                <Separator/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Configuration" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Weighbridge / COM / Hardware" Click="OpenHardwareSettings_Click" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Server Panel - Weight / Cameras / Server" Click="OpenServerPanel_Click" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Data" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="Import Vehicles" Command="{Binding ImportVehiclesCommand}" Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="Import Vehicles from API" Command="{Binding ImportVehiclesFromApiCommand}" Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>
            <MenuItem Header="Control Panel" Style="{StaticResource TopMenuItemStyle}" Click="OpenAdminControls_Click"/>
            <MenuItem Header="About" Style="{StaticResource TopMenuItemStyle}" Click="OpenAbout_Click"/>
        </Menu>

        <!-- TOP: FOUR CAMERAS + SYSTEM INFORMATION -->
        <Grid Grid.Row="1" Margin="6,5,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Four editable cameras -->
            <Grid Grid.Column="0" Margin="0,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera1VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="9,5" CornerRadius="7,7,0,0">
                            <DockPanel>
                                <TextBlock Text="CAMERA 1" Foreground="White" FontWeight="ExtraBold" FontSize="11" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding InCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera2VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="9,5" CornerRadius="7,7,0,0">
                            <DockPanel>
                                <TextBlock Text="CAMERA 2" Foreground="White" FontWeight="ExtraBold" FontSize="11" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding OutCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera3VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="9,5" CornerRadius="7,7,0,0">
                            <DockPanel>
                                <TextBlock Text="CAMERA 3" Foreground="White" FontWeight="ExtraBold" FontSize="11" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera3Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera4VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="9,5" CornerRadius="7,7,0,0">
                            <DockPanel>
                                <TextBlock Text="CAMERA 4" Foreground="White" FontWeight="ExtraBold" FontSize="11" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera4Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right information column -->
            <Grid Grid.Column="1" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.95*"/>
                    <RowDefinition Height="0.64*"/>
                    <RowDefinition Height="0.62*"/>
                    <RowDefinition Height="0.80*"/>
                    <RowDefinition Height="1.22*"/>
                </Grid.RowDefinitions>

                <!-- Branding -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8" BorderBrush="#94A3B8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/RealTechiAWSLogo.png" Stretch="Uniform" Margin="2"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="RealTech iAWS" FontSize="20" FontWeight="ExtraBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="AUTOMATIC WEIGHING SYSTEM" FontSize="9.5" FontWeight="Bold" Foreground="#F97316" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="v0.1" FontSize="10" FontWeight="ExtraBold" Foreground="#16A34A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Date / time -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="9,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DATE" FontSize="9" Foreground="#64748B" FontWeight="ExtraBold"/>
                            <TextBlock Text="{Binding SystemDate}" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="12,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TIME" FontSize="9" Foreground="#64748B" FontWeight="ExtraBold"/>
                                <TextBlock Text="{Binding SystemTime}" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Processed / pending counters (same behavior as the original iTOLL dashboard) -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="PROCESSED" FontSize="9" FontWeight="ExtraBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ProcessedRecords}" Foreground="#15803D" FontSize="21" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="PENDING" FontSize="9" FontWeight="ExtraBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PendingRecords}" Foreground="#B91C1C" FontSize="21" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Connectivity -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="INTERNET / SERVER" FontSize="9.5" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding NetworkStatus}" TextWrapping="Wrap" FontSize="10" Foreground="#334155" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding ServerStatus}" TextWrapping="Wrap" FontSize="9.2" Foreground="#334155" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HARDWARE COM" FontSize="9.5" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding ActiveControlTransport}" FontSize="11" FontWeight="ExtraBold" Foreground="#1D4ED8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding HardwareStatus}" TextWrapping="Wrap" FontSize="9" Foreground="#475569" MaxHeight="26"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Live weight -->
                <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="8" BorderBrush="#334155" BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LIVE WEIGHT" Style="{StaticResource SectionHeader}" FontSize="12"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LiveWeight}" FontSize="36" FontWeight="ExtraBold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <TextBlock Text="{Binding TargetWeight}" FontSize="12" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding WeightProcessStatus}" FontSize="9.5" FontWeight="Bold" Foreground="#EA580C" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding WeighbridgeStatus}" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- SHARED WEIGHBRIDGE DIRECTION: FIRST RFID WINS -->
        <Grid Grid.Row="2" Margin="6,2,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IN LANE -->
            <Border Grid.Column="0" Background="White" BorderBrush="#7FA9E8" BorderThickness="1.5" CornerRadius="9" Margin="3" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Strong RFID stroke / display -->
                    <Border Grid.Row="0" BorderBrush="#2563EB" BorderThickness="2.5" CornerRadius="7" Background="#EFF6FF" Padding="10,5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IN RFID" FontSize="19" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding InRfid}" FontSize="18" FontWeight="ExtraBold" Foreground="#1D4ED8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Use the full available lane width for signal, buzzer and barrier. -->
                    <Grid Grid.Row="1" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.70*"/>
                            <ColumnDefinition Width="1.55*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal + buzzer -->
                        <Border Grid.Column="0" BorderBrush="#D6E0EC" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="6" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIGNAL" FontSize="9" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <Border Grid.Row="1" Width="50" Height="88" CornerRadius="17" Background="#111827" BorderBrush="#475569" BorderThickness="2" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding InSignalState}"/>
                                        <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding InSignalState}"/>
                                        <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding InSignalState}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="3" Margin="4,2,4,0" Tag="{Binding IsInBuzzerActive}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F1E5C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0C2"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="BUZZER" FontSize="7" FontWeight="ExtraBold" Foreground="#A16207" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="2" Text="🔔" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="#D7A64A" VerticalAlignment="Center" HorizontalAlignment="Left" Tag="{Binding IsInBuzzerActive}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7A64A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#F59E0B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Barrier -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1.5" Padding="7" Tag="{Binding IsInBarrierOpen}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF9F9"/>
                                    <Setter Property="BorderBrush" Value="#F1A2A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#F5FFF8"/>
                                            <Setter Property="BorderBrush" Value="#86D8A2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="IN BARRIER" FontSize="9" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,0">
                                    <Grid Width="180" Height="76">
                                        <Rectangle Width="14" Height="42" RadiusX="2" RadiusY="2" Fill="#394457" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,9"/>
                                        <Rectangle Width="26" Height="7" RadiusX="2" RadiusY="2" Fill="#394457" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                                        <Ellipse Width="15" Height="15" Fill="#56657A" Stroke="#263345" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,-2,0,0"/>
                                        <Ellipse Width="5" Height="5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,-2,0,0"/>
                                        <Grid Width="142" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="26,-2,0,0" RenderTransformOrigin="0.02,0.5" Tag="{Binding IsInBarrierOpen}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-72"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="6" Background="#E52B2F" CornerRadius="2" BorderBrush="#BB1F24" BorderThickness="1"/>
                                            <Rectangle Grid.Column="1" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="3" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="5" Fill="White" Margin="0,1"/>
                                        </Grid>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="2" Style="{StaticResource BarrierText}" Tag="{Binding IsInBarrierOpen}" Margin="0,1,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="4,3,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding InAccessStatus}" TextWrapping="Wrap" FontSize="9.5" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding InVehicleNumber}" FontWeight="ExtraBold" FontSize="10" Foreground="#0F172A"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- OUT LANE -->
            <Border Grid.Column="1" Background="White" BorderBrush="#A99BEF" BorderThickness="1.5" CornerRadius="9" Margin="3" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- Strong RFID stroke / display -->
                    <Border Grid.Row="0" BorderBrush="#7C3AED" BorderThickness="2.5" CornerRadius="7" Background="#F5F3FF" Padding="10,5" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="OUT RFID" FontSize="19" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding OutRfid}" FontSize="18" FontWeight="ExtraBold" Foreground="#7C3AED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.70*"/>
                            <ColumnDefinition Width="1.55*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal + buzzer -->
                        <Border Grid.Column="0" BorderBrush="#D6E0EC" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="6" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="38"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIGNAL" FontSize="9" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <Border Grid.Row="1" Width="50" Height="88" CornerRadius="17" Background="#111827" BorderBrush="#475569" BorderThickness="2" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding OutSignalState}"/>
                                        <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding OutSignalState}"/>
                                        <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding OutSignalState}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="3" Margin="4,2,4,0" Tag="{Binding IsOutBuzzerActive}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F1E5C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0C2"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="BUZZER" FontSize="7" FontWeight="ExtraBold" Foreground="#A16207" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="2" Text="🔔" FontFamily="Segoe UI Symbol" FontSize="15" Foreground="#D7A64A" VerticalAlignment="Center" HorizontalAlignment="Left" Tag="{Binding IsOutBuzzerActive}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7A64A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#F59E0B" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Barrier -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1.5" Padding="7" Tag="{Binding IsOutBarrierOpen}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF9F9"/>
                                    <Setter Property="BorderBrush" Value="#F1A2A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#F5FFF8"/>
                                            <Setter Property="BorderBrush" Value="#86D8A2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="OUT BARRIER" FontSize="9" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="6,0">
                                    <Grid Width="180" Height="76">
                                        <Rectangle Width="14" Height="42" RadiusX="2" RadiusY="2" Fill="#394457" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,9"/>
                                        <Rectangle Width="26" Height="7" RadiusX="2" RadiusY="2" Fill="#394457" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                                        <Ellipse Width="15" Height="15" Fill="#56657A" Stroke="#263345" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,-2,0,0"/>
                                        <Ellipse Width="5" Height="5" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,-2,0,0"/>
                                        <Grid Width="142" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="26,-2,0,0" RenderTransformOrigin="0.02,0.5" Tag="{Binding IsOutBarrierOpen}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-72"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/><ColumnDefinition Width="23.67"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="6" Background="#E52B2F" CornerRadius="2" BorderBrush="#BB1F24" BorderThickness="1"/>
                                            <Rectangle Grid.Column="1" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="3" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="5" Fill="White" Margin="0,1"/>
                                        </Grid>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Row="2" Style="{StaticResource BarrierText}" Tag="{Binding IsOutBarrierOpen}" Margin="0,1,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="4,3,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OutAccessStatus}" TextWrapping="Wrap" FontSize="9.5" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding OutVehicleNumber}" FontWeight="ExtraBold" FontSize="10" Foreground="#0F172A"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- LOGS -->
        <Grid Grid.Row="3" Margin="6,2,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="3" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,5">
                        <TextBlock Text="SERVER LOG" FontSize="10.5" FontWeight="ExtraBold" Foreground="#334155"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ServerLogs}" FontFamily="Consolas" FontSize="9.5" BorderThickness="0" Background="White" Padding="4"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="3" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,5">
                        <TextBlock Text="STATUS LOG" FontSize="10.5" FontWeight="ExtraBold" Foreground="#334155"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding StatusLogs}" FontFamily="Consolas" FontSize="9.5" BorderThickness="0" Background="White" Padding="4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="#0F172A" Padding="10,4">
            <DockPanel LastChildFill="True">
                <TextBlock Text="RealTech iAWS v0.1  •  SINGLE WEIGHBRIDGE  •  FIRST RFID WINS  •  4 EDITABLE CAMERAS" Foreground="#E2E8F0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProcessedRecords, StringFormat='Processed Today: {0}'}" Foreground="#A7F3D0" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                <TextBlock Text="{Binding PendingRecords, StringFormat='Pending Sync: {0}'}" Foreground="#FDE68A" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
