<Window x:Class="RfidVehicleAccess.ServerPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS - Server Panel"
        Icon="Assets/RealTechiAWS.ico"
        Width="1040"
        Height="760"
        MinWidth="640"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#E8F3EA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ServerPanelButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#14532D" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="Foreground" Value="#166534" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#15803D"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server Panel"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Edit the application configuration without opening appsettings.json."
                               Foreground="#DCFCE7"
                               Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Protected Configuration"
                           Foreground="#BBF7D0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl x:Name="SettingsTabs"
                    Grid.Row="1"
                    Background="#F7FCF8"
                    BorderBrush="#86B993" />

        <Border x:Name="StatusBorder"
                Grid.Row="2"
                Background="#ECFDF5"
                BorderBrush="#86EFAC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,10,0,4">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Review the settings, then select Save &amp; Apply."
                       Foreground="#166534"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Reload Current Values"
                    HorizontalAlignment="Left"
                    Style="{StaticResource ServerPanelButtonStyle}"
                    Click="ReloadButton_Click" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close"
                        IsCancel="True"
                        Style="{StaticResource ServerPanelButtonStyle}" />
                <Button x:Name="SaveButton"
                        Content="Save &amp; Apply"
                        IsDefault="True"
                        Background="#DCFCE7"
                        BorderBrush="#16A34A"
                        Style="{StaticResource ServerPanelButtonStyle}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
