<Window x:Class="RfidVehicleAccess.HardwareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS - Automatic Weighing System - COM Port Settings"
        Icon="pack://application:,,,/Assets/RealTechiAWS.ico"
        Width="660"
        Height="570"
        MinWidth="560"
        MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#E5E7EB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Hardware / COM Port Configuration"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   Margin="0,0,0,4" />

        <TextBlock Grid.Row="1"
                   Text="Select the actual Windows COM ports. Saving reconnects immediately; application restart is not required."
                   TextWrapping="Wrap"
                   Foreground="#475569"
                   Margin="0,0,0,10" />

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#94A3B8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="135" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="DEVICE"
                           FontWeight="Bold"
                           Foreground="#64748B" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="COM PORT"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           Margin="4,0" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="BAUD RATE"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           Margin="4,0" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="IN RFID Reader" FontWeight="SemiBold" />
                <ComboBox x:Name="InPortComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="True" />
                <ComboBox x:Name="InBaudRateComboBox"
                          Grid.Row="1"
                          Grid.Column="2"
                          IsEditable="True" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="OUT RFID Reader" FontWeight="SemiBold" />
                <ComboBox x:Name="OutPortComboBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="True" />
                <ComboBox x:Name="OutBaudRateComboBox"
                          Grid.Row="2"
                          Grid.Column="2"
                          IsEditable="True" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Control Unit (Wired)" FontWeight="SemiBold" />
                <ComboBox x:Name="ControlPortComboBox"
                          Grid.Row="3"
                          Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="True" />
                <ComboBox x:Name="ControlBaudRateComboBox"
                          Grid.Row="3"
                          Grid.Column="2"
                          IsEditable="True" />

                <StackPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Bluetooth Backup" FontWeight="SemiBold" />
                    <CheckBox x:Name="BluetoothEnabledCheckBox"
                              Content="Enable failover"
                              Margin="0,2,0,0"
                              Checked="BluetoothEnabledCheckBox_Changed"
                              Unchecked="BluetoothEnabledCheckBox_Changed" />
                </StackPanel>
                <ComboBox x:Name="BluetoothPortComboBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          IsEditable="True"
                          IsTextSearchEnabled="True" />
                <ComboBox x:Name="BluetoothBaudRateComboBox"
                          Grid.Row="4"
                          Grid.Column="2"
                          IsEditable="True" />

                <StackPanel Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Wi-Fi Terminal Backup" FontWeight="SemiBold" />
                    <CheckBox x:Name="WifiEnabledCheckBox"
                              Content="Enable 3rd failover"
                              Margin="0,2,0,0"
                              Checked="WifiEnabledCheckBox_Changed"
                              Unchecked="WifiEnabledCheckBox_Changed" />
                </StackPanel>
                <TextBox x:Name="WifiHostTextBox"
                         Grid.Row="5" Grid.Column="1"
                         Margin="4" Padding="6,4" MinHeight="32"
                         VerticalContentAlignment="Center"
                         ToolTip="Wi-Fi serial terminal IP/host" />
                <TextBox x:Name="WifiPortTextBox"
                         Grid.Row="5" Grid.Column="2"
                         Margin="4" Padding="6,4" MinHeight="32"
                         VerticalContentAlignment="Center"
                         ToolTip="TCP port (for example 23)" />

                <CheckBox x:Name="SimulationCheckBox"
                          Grid.Row="6"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Content="Simulation mode (do not open COM ports)"
                          FontWeight="SemiBold"
                          Margin="4,12,4,2"
                          Checked="SimulationCheckBox_Changed"
                          Unchecked="SimulationCheckBox_Changed" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                x:Name="StatusBorder"
                Background="#EFF6FF"
                BorderBrush="#93C5FD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8"
                Margin="0,10,0,6">
            <TextBlock x:Name="StatusTextBlock"
                       TextWrapping="Wrap"
                       Foreground="#1E3A8A" />
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Refresh COM List"
                    HorizontalAlignment="Left"
                    Click="RefreshPorts_Click" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel"
                        IsCancel="True" />
                <Button x:Name="SaveButton"
                        Content="Save &amp; Connect"
                        IsDefault="True"
                        Background="#DCFCE7"
                        BorderBrush="#16A34A"
                        FontWeight="Bold"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
