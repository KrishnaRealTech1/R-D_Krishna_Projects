<Window x:Class="RfidVehicleAccess.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS - Automatic Weighing System - Admin Authentication"
        Icon="pack://application:,,,/Assets/RealTechiAWS.ico"
        Width="430"
        MinWidth="410"
        MinHeight="275"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded">
    <Grid Margin="22,20,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingTextBlock"
                   Grid.Row="0"
                   Text="Admin Controls"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#0F172A" />

        <TextBlock x:Name="DescriptionTextBlock"
                   Grid.Row="1"
                   Margin="0,7,0,14"
                   Text="Enter the admin password to open manual hardware controls."
                   Foreground="#475569"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="2"
                   Text="Password"
                   FontWeight="SemiBold"
                   Foreground="#1E293B" />

        <PasswordBox x:Name="AdminPasswordBox"
                     Grid.Row="3"
                     Height="40"
                     Margin="0,5,0,0"
                     Padding="8,5"
                     FontSize="16"
                     PasswordChar="●"
                     KeyDown="AdminPasswordBox_KeyDown" />

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="4"
                   Margin="0,8,0,0"
                   Foreground="#B91C1C"
                   FontWeight="SemiBold"
                   Visibility="Collapsed"
                   Text="Incorrect password." />

        <StackPanel Grid.Row="5"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="96"
                    Height="38"
                    Padding="12,6"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="Unlock"
                    Width="96"
                    Height="38"
                    Padding="12,6"
                    IsDefault="True"
                    Click="Unlock_Click"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
