{
  "Device": {
    "SiteId": "SITE-001",
    "DeviceId": "IAWS-001",
    "LaneId": "WEIGHBRIDGE-01",
    "DeviceName": "iAWS Automatic Weighing System"
  },
  "Iaws": {
    "ApiEndpoint": "https://YOUR-SERVER/iaws_raw/mega/insert",
    "ApiTimeoutSeconds": 30,
    "TriggerWeightKg": 500.0,
    "ResetWeightKg": 100.0,
    "RfidFreshnessSeconds": 30,
    "SitePrefix": "AMMAN_KOIL_THAMBARAM",
    "MaterialType": "",
    "RequireAllCameras": true
  },
  "Hardware": {
    "SimulationEnabled": true,
    "LineTerminator": "\\r\\n",
    "ReconnectSeconds": 5,
    "RfidReader": {
      "PortName": "COM3",
      "BaudRate": 115200,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "ReadMode": "UhfCfFrame"
    },
    "WeightBridge": {
      "PortName": "COM12",
      "BaudRate": 9600,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "WeightPattern": "(?i)\\bwn\\s*(?<weight>\\d{1,9}(?:\\.\\d+)?)\\s*kg\\b"
    }
  },
  "Cameras": {
    "Front": {
      "Enabled": true,
      "RtspUrl": "rtsp://admin:password@192.168.1.201:554/Streaming/channels/101",
      "SnapshotWidth": 1920,
      "SnapshotHeight": 1080,
      "NetworkCachingMilliseconds": 1200,
      "ReconnectSeconds": 5,
      "UseTcp": true,
      "EnableHardwareDecoding": false
    },
    "Back": {
      "Enabled": true,
      "RtspUrl": "rtsp://admin:password@192.168.1.202:554/Streaming/channels/101",
      "SnapshotWidth": 1920,
      "SnapshotHeight": 1080,
      "NetworkCachingMilliseconds": 1200,
      "ReconnectSeconds": 5,
      "UseTcp": true,
      "EnableHardwareDecoding": false
    },
    "Left": {
      "Enabled": true,
      "RtspUrl": "rtsp://admin:password@192.168.1.203:554/Streaming/channels/101",
      "SnapshotWidth": 1920,
      "SnapshotHeight": 1080,
      "NetworkCachingMilliseconds": 1200,
      "ReconnectSeconds": 5,
      "UseTcp": true,
      "EnableHardwareDecoding": false
    },
    "Right": {
      "Enabled": true,
      "RtspUrl": "rtsp://admin:password@192.168.1.204:554/Streaming/channels/101",
      "SnapshotWidth": 1920,
      "SnapshotHeight": 1080,
      "NetworkCachingMilliseconds": 1200,
      "ReconnectSeconds": 5,
      "UseTcp": true,
      "EnableHardwareDecoding": false
    },
    "LocalImageFolder": "%IAWS_SYSTEM%\\Images"
  },
  "Storage": {
    "StatusLogFile": "%IAWS_SYSTEM%\\Logs\\Status\\status.log",
    "ApiLogFile": "%IAWS_SYSTEM%\\Logs\\Api\\api.log"
  }
}
