<Window x:Class="RfidVehicleAccess.IawsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iAWS - Hardware / API Settings"
        Width="760"
        Height="570"
        MinWidth="660"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#E5E7EB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="i" Foreground="#F59E0B" FontSize="27" FontWeight="Black" />
                <TextBlock Text="AWS" Foreground="#22C55E" FontSize="27" FontWeight="Black" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Hardware / API Configuration" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="Configure one weighbridge, one RFID reader, four cameras and the direct REST API. Saving reconnects hardware immediately."
                   TextWrapping="Wrap"
                   Foreground="#475569"
                   Margin="0,0,0,10" />

        <Border Grid.Row="2" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="8" Padding="8">
            <TabControl>
                <TabItem Header="Process &amp; API">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="API endpoint" FontWeight="SemiBold" />
                        <TextBox x:Name="ApiEndpointTextBox" Grid.Row="0" Grid.Column="1" />
                        <TextBlock Grid.Row="1" Text="API timeout (seconds)" FontWeight="SemiBold" />
                        <TextBox x:Name="ApiTimeoutTextBox" Grid.Row="1" Grid.Column="1" />
                        <TextBlock Grid.Row="2" Text="Site image prefix" FontWeight="SemiBold" />
                        <TextBox x:Name="SitePrefixTextBox" Grid.Row="2" Grid.Column="1" />
                        <TextBlock Grid.Row="3" Text="Material type (optional)" FontWeight="SemiBold" />
                        <TextBox x:Name="MaterialTypeTextBox" Grid.Row="3" Grid.Column="1" />
                        <TextBlock Grid.Row="4" Text="Trigger weight (kg)" FontWeight="SemiBold" />
                        <TextBox x:Name="TriggerWeightTextBox" Grid.Row="4" Grid.Column="1" />
                        <TextBlock Grid.Row="5" Text="Reset below weight (kg)" FontWeight="SemiBold" />
                        <TextBox x:Name="ResetWeightTextBox" Grid.Row="5" Grid.Column="1" />
                        <TextBlock Grid.Row="6" Text="RFID freshness (seconds)" FontWeight="SemiBold" />
                        <TextBox x:Name="RfidFreshnessTextBox" Grid.Row="6" Grid.Column="1" />
                        <CheckBox x:Name="RequireAllCamerasCheckBox"
                                  Grid.Row="7" Grid.Column="1"
                                  Content="Require all 4 camera snapshots before API submission"
                                  Margin="4,12,4,4" />
                    </Grid>
                </TabItem>

                <TabItem Header="RFID &amp; Weighbridge">
                    <StackPanel Margin="14">
                        <CheckBox x:Name="SimulationCheckBox"
                                  Content="Simulation mode (do not open physical RFID / weighbridge COM ports)"
                                  FontWeight="SemiBold"
                                  Margin="4,2,4,10" />

                        <GroupBox Header="RFID Reader" Margin="2,2,2,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="COM port" FontWeight="SemiBold" />
                                <ComboBox x:Name="RfidPortComboBox" Grid.Row="0" Grid.Column="1" IsEditable="True" />
                                <TextBlock Grid.Row="1" Text="Baud rate" FontWeight="SemiBold" />
                                <TextBox x:Name="RfidBaudTextBox" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="2" Text="Read mode" FontWeight="SemiBold" />
                                <ComboBox x:Name="RfidReadModeComboBox" Grid.Row="2" Grid.Column="1">
                                    <ComboBoxItem Content="UhfCfFrame" />
                                    <ComboBoxItem Content="LineText" />
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Weight Bridge" Margin="2,2,2,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="COM port" FontWeight="SemiBold" />
                                <ComboBox x:Name="WeightPortComboBox" Grid.Row="0" Grid.Column="1" IsEditable="True" />
                                <TextBlock Grid.Row="1" Text="Baud rate" FontWeight="SemiBold" />
                                <TextBox x:Name="WeightBaudTextBox" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="2" Text="Weight number regex" FontWeight="SemiBold" />
                                <TextBox x:Name="WeightPatternTextBox" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="Sample supported: wn000000 kg / wn009011 kg  →  0 kg / 9011 kg"
                                           Foreground="#475569" FontSize="10" Margin="5,1,4,4" TextWrapping="Wrap" />
                            </Grid>
                        </GroupBox>

                        <Button Content="Refresh COM List" Click="RefreshPorts_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="4 Cameras">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="API filename format: &lt;SitePrefix&gt;_CAM_&lt;n&gt;_HHmmss_DDMMYYYY.jpg"
                                   Foreground="#475569" FontWeight="SemiBold" Margin="3,2,3,10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Camera 1 - Front" FontWeight="SemiBold" />
                        <CheckBox x:Name="FrontEnabledCheckBox" Grid.Row="1" Grid.Column="1" Content="Enabled" Margin="3" />
                        <TextBox x:Name="FrontUrlTextBox" Grid.Row="1" Grid.Column="2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Camera 2 - Back" FontWeight="SemiBold" />
                        <CheckBox x:Name="BackEnabledCheckBox" Grid.Row="2" Grid.Column="1" Content="Enabled" Margin="3" />
                        <TextBox x:Name="BackUrlTextBox" Grid.Row="2" Grid.Column="2" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Camera 3 - Left" FontWeight="SemiBold" />
                        <CheckBox x:Name="LeftEnabledCheckBox" Grid.Row="3" Grid.Column="1" Content="Enabled" Margin="3" />
                        <TextBox x:Name="LeftUrlTextBox" Grid.Row="3" Grid.Column="2" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Camera 4 - Right" FontWeight="SemiBold" />
                        <CheckBox x:Name="RightEnabledCheckBox" Grid.Row="4" Grid.Column="1" Content="Enabled" Margin="3" />
                        <TextBox x:Name="RightUrlTextBox" Grid.Row="4" Grid.Column="2" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Local image folder" FontWeight="SemiBold" />
                        <TextBox x:Name="ImageFolderTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,8,0,4">
            <TextBlock x:Name="StatusTextBlock" Foreground="#1E3A8A" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Width="90" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Content="Save &amp; Apply" Width="118" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
