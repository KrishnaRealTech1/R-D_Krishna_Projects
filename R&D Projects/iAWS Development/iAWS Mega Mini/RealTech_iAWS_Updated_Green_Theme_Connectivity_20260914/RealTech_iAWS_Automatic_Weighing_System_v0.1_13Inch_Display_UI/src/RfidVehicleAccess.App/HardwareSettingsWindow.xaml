<Window x:Class="RfidVehicleAccess.HardwareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS - Weighbridge / Hardware Configuration"
        Icon="Assets/RealTechiAWS.ico"
        Width="760" Height="600"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F3F4F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="iAWS v0.1 - Single Weighbridge Hardware" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Configure the one weight bridge plus IN/OUT RFID and control COM ports." Foreground="#4B5563" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Operating Mode" Margin="0,0,0,10" Padding="10">
                    <CheckBox x:Name="SimulationCheckBox" Content="Simulation mode (do not open physical COM ports)"/>
                </GroupBox>

                <GroupBox Header="Single Weight Bridge" Margin="0,0,0,10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Weight COM" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="WeightPortComboBox" Grid.Row="0" Grid.Column="1" IsEditable="True" Margin="4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Baud Rate" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="WeightBaudRateComboBox" Grid.Row="0" Grid.Column="3" IsEditable="True" Margin="4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Weight (KG)" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="TargetWeightTextBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Reset Weight (KG)" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="ResetWeightTextBox" Grid.Row="1" Grid.Column="3" Margin="4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial Prefix" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="WeightPrefixTextBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Unit Text" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="WeightUnitTextBox" Grid.Row="2" Grid.Column="3" Margin="4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Stable Read Count" VerticalAlignment="Center" Margin="4"/>
                        <TextBox x:Name="StableReadCountTextBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Expected Sample" VerticalAlignment="Center" Margin="4"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="wn009011 kg" FontFamily="Consolas" FontWeight="Bold" Margin="4"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="RFID and Boom / Signal Controller" Margin="0,0,0,10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IN RFID COM" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="InPortComboBox" Grid.Row="0" Grid.Column="1" IsEditable="True" Margin="4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Baud Rate" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="InBaudRateComboBox" Grid.Row="0" Grid.Column="3" IsEditable="True" Margin="4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="OUT RFID COM" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="OutPortComboBox" Grid.Row="1" Grid.Column="1" IsEditable="True" Margin="4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Baud Rate" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="OutBaudRateComboBox" Grid.Row="1" Grid.Column="3" IsEditable="True" Margin="4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Control COM" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="ControlPortComboBox" Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Baud Rate" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="ControlBaudRateComboBox" Grid.Row="2" Grid.Column="3" IsEditable="True" Margin="4"/>

                        <CheckBox x:Name="BluetoothEnabledCheckBox" Grid.Row="3" Grid.Column="0" Content="Bluetooth backup" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="BluetoothPortComboBox" Grid.Row="3" Grid.Column="1" IsEditable="True" Margin="4"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Baud Rate" VerticalAlignment="Center" Margin="4"/>
                        <ComboBox x:Name="BluetoothBaudRateComboBox" Grid.Row="3" Grid.Column="3" IsEditable="True" Margin="4"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,10,0,10">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Refresh COM Ports" Width="135" Margin="4" Click="RefreshPorts_Click"/>
            <Button x:Name="SaveButton" Content="Save &amp; Apply" Width="120" Margin="4" Click="SaveButton_Click"/>
            <Button Content="Close" Width="90" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
