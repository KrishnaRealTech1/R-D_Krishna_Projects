<Application x:Class="RfidVehicleAccess.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- iTOLL-style neutral desktop palette with iAWS green/orange accents. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#15803D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#C2410C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="Foreground" Value="#166534" />
            <Setter Property="BorderBrush" Value="#16A34A" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
