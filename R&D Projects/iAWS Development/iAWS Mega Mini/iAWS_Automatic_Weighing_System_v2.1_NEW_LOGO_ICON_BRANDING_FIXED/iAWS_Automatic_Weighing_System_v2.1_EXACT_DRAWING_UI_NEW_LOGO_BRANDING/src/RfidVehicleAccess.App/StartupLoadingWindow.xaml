<Window x:Class="RfidVehicleAccess.StartupLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS - Loading"
        Icon="Assets/RealTechiAWS.ico"
        Width="570"
        Height="330"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="#FFFFFF"
            BorderBrush="#42CB19"
            BorderThickness="2"
            CornerRadius="16"
            Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#142019" BlurRadius="26" ShadowDepth="4" Opacity="0.28" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="152" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#FFFFFF" BorderBrush="#74E451" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,14,0">
                    <Image Source="Assets/RealTechiAWSLogo.png" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="RealTech iAWS" Foreground="#1B2A21" FontSize="22" FontWeight="ExtraBold" />
                    <TextBlock Text="AUTOMATIC WEIGHING SYSTEM" Foreground="#15803D" FontSize="16" FontWeight="ExtraBold" Margin="0,2,0,0" />
                    <TextBlock Text="RFID • 4 Cameras • Weighbridge • REST API" Foreground="#617067" FontSize="11.5" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Preparing iAWS..." Foreground="#142019" FontSize="17" FontWeight="Bold" Margin="0,24,0,5" />
            <TextBlock x:Name="DetailText" Grid.Row="2" Text="Loading configuration and hardware services." Foreground="#617067" FontSize="12" TextWrapping="Wrap" MinHeight="38" />

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
                <ProgressBar x:Name="LoadingProgressBar" Minimum="0" Maximum="100" Value="5" Height="12" Foreground="#39C814" Background="#EAF6E6" BorderBrush="#9CDE87" />
                <TextBlock x:Name="PercentageText" Grid.Column="1" Text="5%" Foreground="#178600" FontWeight="ExtraBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="4" Background="#F7FBF8" BorderBrush="#D8E2DC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,18,0,0">
                <TextBlock Text="iAWS uses direct REST API processing with weight-triggered capture and four cameras."
                           Foreground="#4D6054" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
