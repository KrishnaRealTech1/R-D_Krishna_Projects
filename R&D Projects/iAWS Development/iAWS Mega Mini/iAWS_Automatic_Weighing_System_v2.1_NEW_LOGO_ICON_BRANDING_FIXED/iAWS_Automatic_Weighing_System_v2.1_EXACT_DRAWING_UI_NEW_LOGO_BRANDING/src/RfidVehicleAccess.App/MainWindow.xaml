<Window x:Class="RfidVehicleAccess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="RealTech iAWS - Automatic Weighing System"
        Icon="Assets/RealTechiAWS.ico"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="720"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="OuterPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7" />
        </Style>

        <Style x:Key="LaneInnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <Style x:Key="SmallHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LaneHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CameraBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#071018" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0.7" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="SignalRedStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#5F1D1D" />
            <Setter Property="Stroke" Value="#991B1B" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.35" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProcessError}" Value="True">
                    <Setter Property="Fill" Value="#FF3030" />
                    <Setter Property="Stroke" Value="#FCA5A5" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3030" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalOrangeStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#7C2D12" />
            <Setter Property="Stroke" Value="#9A3412" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.35" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessBusy}" Value="True">
                    <Setter Property="Fill" Value="#FF9F0A" />
                    <Setter Property="Stroke" Value="#FED7AA" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF9F0A" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalGreenStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#14532D" />
            <Setter Property="Stroke" Value="#166534" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.35" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProcessReady}" Value="True">
                    <Setter Property="Fill" Value="#20D760" />
                    <Setter Property="Stroke" Value="#BBF7D0" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#20D760" BlurRadius="14" ShadowDepth="0" Opacity="0.85" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConnectivityDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Fill" Value="#EF4444" />
            <Setter Property="Stroke" Value="#991B1B" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHardwareReady}" Value="True">
                    <Setter Property="Fill" Value="#22C55E" />
                    <Setter Property="Stroke" Value="#15803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeightConnectivityDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Fill" Value="#EF4444" />
            <Setter Property="Stroke" Value="#991B1B" />
            <Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeightConnected}" Value="True">
                    <Setter Property="Fill" Value="#22C55E" />
                    <Setter Property="Stroke" Value="#15803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Height="25">
            <MenuItem Header="_File">
                <MenuItem Header="Open Capture _Folder" Command="{Binding OpenCaptureFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="iAWS Hardware / API Settings..." Click="OpenSettings_Click" />
            </MenuItem>
            <MenuItem Header="_System">
                <MenuItem Header="Reset Current Weighing Cycle" Command="{Binding ResetCycleCommand}" />
                <MenuItem Header="Open Images Folder" Command="{Binding OpenCaptureFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="RealTech iAWS Automatic Weighing System v2.1" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- Exact structure from the supplied hand-drawn iAWS sheet:
             TOP = four cameras + branding/status/weight,
             MIDDLE = IN RFID + OUT RFID hardware presentation,
             BOTTOM = Server Log + Status Log. -->
        <Grid Margin="8,6,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="3.05*" MinHeight="330" />
                <RowDefinition Height="1.82*" MinHeight="205" />
                <RowDefinition Height="1.18*" MinHeight="125" />
            </Grid.RowDefinitions>

            <!-- TOP AREA -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.28*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- FOUR-CAMERA 2x2 BLOCK -->
                <Border Grid.Column="0" Style="{StaticResource OuterPanelStyle}" Margin="0,0,5,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CameraBorderStyle}">
                            <Grid>
                                <vlc:VideoView x:Name="FrontVideoView" />
                                <Border Background="#B8000000" VerticalAlignment="Bottom" Padding="8,5">
                                    <Grid>
                                        <TextBlock Text="CAMERA 1  •  FRONT" Foreground="White" FontSize="11" FontWeight="ExtraBold" />
                                        <TextBlock Text="{Binding FrontCameraStatus}" Foreground="#BBF7D0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CameraBorderStyle}">
                            <Grid>
                                <vlc:VideoView x:Name="BackVideoView" />
                                <Border Background="#B8000000" VerticalAlignment="Bottom" Padding="8,5">
                                    <Grid>
                                        <TextBlock Text="CAMERA 2  •  BACK" Foreground="White" FontSize="11" FontWeight="ExtraBold" />
                                        <TextBlock Text="{Binding BackCameraStatus}" Foreground="#BBF7D0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CameraBorderStyle}">
                            <Grid>
                                <vlc:VideoView x:Name="LeftVideoView" />
                                <Border Background="#B8000000" VerticalAlignment="Bottom" Padding="8,5">
                                    <Grid>
                                        <TextBlock Text="CAMERA 3  •  LEFT" Foreground="White" FontSize="11" FontWeight="ExtraBold" />
                                        <TextBlock Text="{Binding LeftCameraStatus}" Foreground="#FED7AA" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CameraBorderStyle}">
                            <Grid>
                                <vlc:VideoView x:Name="RightVideoView" />
                                <Border Background="#B8000000" VerticalAlignment="Bottom" Padding="8,5">
                                    <Grid>
                                        <TextBlock Text="CAMERA 4  •  RIGHT" Foreground="White" FontSize="11" FontWeight="ExtraBold" />
                                        <TextBlock Text="{Binding RightCameraStatus}" Foreground="#FED7AA" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT STATUS RAIL -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.02*" />
                        <RowDefinition Height="0.70*" />
                        <RowDefinition Height="0.88*" />
                        <RowDefinition Height="1.18*" />
                    </Grid.RowDefinitions>

                    <!-- Logo / RealTech iAWS -->
                    <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,4" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,7,0" Padding="2">
                                <Image Source="Assets/RealTechiAWSLogo.png" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="RealTech iAWS" Foreground="#111827" FontSize="19" FontWeight="ExtraBold" />
                                <TextBlock Text="AUTOMATIC WEIGHING SYSTEM" Foreground="#15803D" FontSize="10" FontWeight="ExtraBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SitePrefix}" Foreground="#64748B" FontSize="9.5" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Date / Time -->
                    <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,4" Padding="8,5">
                        <Grid>
                            <TextBlock Text="DATE / TIME" Style="{StaticResource SmallHeadingStyle}" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding SystemTime}" Foreground="#1E3A8A" FontSize="18" FontWeight="ExtraBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Internet / Server + Hardware COM -->
                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,2,0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#F59E0B" Stroke="#B45309" StrokeThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="INTERNET / SERVER" Style="{StaticResource SmallHeadingStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding ServerConnectivityText}" Foreground="#334155" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="2,0,0,0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource ConnectivityDotStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="HARDWARE / COM" Style="{StaticResource SmallHeadingStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding HardwareStatus}" Foreground="#334155" FontSize="9.4" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Weight data + connectivity strip -->
                    <Border Grid.Row="3" Style="{StaticResource DashboardCardStyle}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="9,7,6,7">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="WEIGHT DATA" Style="{StaticResource SmallHeadingStyle}" />
                                    <TextBlock Text="{Binding WeightStatusText}" Foreground="#15803D" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding CurrentWeightText}" Foreground="#0F172A" FontSize="36" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Grid Grid.Row="2">
                                    <TextBlock Text="RFID" Foreground="#64748B" FontSize="9" FontWeight="ExtraBold" />
                                    <TextBlock Text="{Binding CurrentRfid}" Foreground="#B91C1C" FontFamily="Consolas" FontSize="10.5" FontWeight="ExtraBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                </Grid>
                            </Grid>

                            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0" Background="#F8FAFC">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Style="{StaticResource WeightConnectivityDotStyle}" />
                                    <TextBlock Text="WEIGHT" Foreground="#475569" FontSize="8" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding WeightConnectivityText}" Foreground="#334155" FontSize="8" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Width="50" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- MIDDLE: IN RFID / OUT RFID -->
            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- IN -->
                <Border Grid.Column="0" Style="{StaticResource OuterPanelStyle}" Margin="0,0,3,0" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Margin="0,0,0,7">
                            <Grid>
                                <Border Width="22" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="0,0,1,0" HorizontalAlignment="Left" />
                                <TextBlock Text="IN      RFID" Style="{StaticResource LaneHeaderStyle}" />
                                <TextBlock Text="{Binding CurrentRfid}" Foreground="#B91C1C" FontFamily="Consolas" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="175" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.78*" />
                                <ColumnDefinition Width="1.08*" />
                                <ColumnDefinition Width="1.42*" />
                            </Grid.ColumnDefinitions>

                            <!-- IN signal -->
                            <Border Grid.Column="0" Style="{StaticResource LaneInnerCardStyle}" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="55" Height="112" Background="#18212A" BorderBrush="#64748B" BorderThickness="1" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="9,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <Ellipse Width="28" Height="28" Margin="0,3" Style="{StaticResource SignalRedStyle}" />
                                            <Ellipse Width="28" Height="28" Margin="0,3" Style="{StaticResource SignalOrangeStyle}" />
                                            <Ellipse Width="28" Height="28" Margin="0,3" Style="{StaticResource SignalGreenStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="IN SIGNAL" Foreground="#334155" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </Grid>
                            </Border>

                            <!-- IN buzzer -->
                            <Border Grid.Column="1" Style="{StaticResource LaneInnerCardStyle}" Margin="0,0,5,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="76" Height="72" Background="#FFF7ED" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <TextBlock Text="🔊" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="IN BUZZER" Foreground="#334155" FontSize="10" FontWeight="ExtraBold" Margin="0,8,0,0" />
                                    <TextBlock Text="STANDBY" Foreground="#B45309" FontSize="9" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <!-- IN boom barrier -->
                            <Border Grid.Column="2" Style="{StaticResource LaneInnerCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Canvas Width="180" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Canvas.Left="17" Canvas.Top="31" Width="33" Height="76" Background="#E2E8F0" BorderBrush="#475569" BorderThickness="2" CornerRadius="3" />
                                        <Border Canvas.Left="45" Canvas.Top="45" Width="105" Height="13" BorderBrush="#475569" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFFFFF" Offset="0" />
                                                    <GradientStop Color="#EF4444" Offset="0.22" />
                                                    <GradientStop Color="#FFFFFF" Offset="0.44" />
                                                    <GradientStop Color="#EF4444" Offset="0.66" />
                                                    <GradientStop Color="#FFFFFF" Offset="0.88" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Canvas.Left="35" Canvas.Top="42" Width="18" Height="18" Fill="#334155" />
                                    </Canvas>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,2">
                                        <TextBlock Text="IN BOOM BARRIER" Foreground="#334155" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="CLOSED" Foreground="#B91C1C" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- OUT -->
                <Border Grid.Column="1" Style="{StaticResource OuterPanelStyle}" Margin="3,0,0,0" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Margin="0,0,0,7">
                            <Grid>
                                <Border Width="22" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="0,0,1,0" HorizontalAlignment="Left" />
                                <TextBlock Text="OUT      RFID" Style="{StaticResource LaneHeaderStyle}" />
                                <TextBlock Text="WAITING" Foreground="#64748B" FontFamily="Consolas" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.78*" />
                                <ColumnDefinition Width="1.08*" />
                                <ColumnDefinition Width="1.42*" />
                            </Grid.ColumnDefinitions>

                            <!-- OUT signal -->
                            <Border Grid.Column="0" Style="{StaticResource LaneInnerCardStyle}" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="55" Height="112" Background="#18212A" BorderBrush="#64748B" BorderThickness="1" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="9,6">
                                        <StackPanel VerticalAlignment="Center">
                                            <Ellipse Width="28" Height="28" Margin="0,3" Style="{StaticResource SignalRedStyle}" />
                                            <Ellipse Width="28" Height="28" Margin="0,3" Style="{StaticResource SignalOrangeStyle}" />
                                            <Ellipse Width="28" Height="28" Margin="0,3" Style="{StaticResource SignalGreenStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="OUT SIGNAL" Foreground="#334155" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </Grid>
                            </Border>

                            <!-- OUT buzzer -->
                            <Border Grid.Column="1" Style="{StaticResource LaneInnerCardStyle}" Margin="0,0,5,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="76" Height="72" Background="#FFF7ED" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <TextBlock Text="🔊" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="OUT BUZZER" Foreground="#334155" FontSize="10" FontWeight="ExtraBold" Margin="0,8,0,0" />
                                    <TextBlock Text="STANDBY" Foreground="#B45309" FontSize="9" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <!-- OUT boom barrier -->
                            <Border Grid.Column="2" Style="{StaticResource LaneInnerCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Canvas Width="180" Height="116" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Canvas.Left="17" Canvas.Top="31" Width="33" Height="76" Background="#E2E8F0" BorderBrush="#475569" BorderThickness="2" CornerRadius="3" />
                                        <Border Canvas.Left="45" Canvas.Top="45" Width="105" Height="13" BorderBrush="#475569" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFFFFF" Offset="0" />
                                                    <GradientStop Color="#EF4444" Offset="0.22" />
                                                    <GradientStop Color="#FFFFFF" Offset="0.44" />
                                                    <GradientStop Color="#EF4444" Offset="0.66" />
                                                    <GradientStop Color="#FFFFFF" Offset="0.88" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Canvas.Left="35" Canvas.Top="42" Width="18" Height="18" Fill="#334155" />
                                    </Canvas>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,2">
                                        <TextBlock Text="OUT BOOM BARRIER" Foreground="#334155" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="CLOSED" Foreground="#B91C1C" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- BOTTOM LOGS: exact drawing order = Server Log left, Status Log right -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Server Log" Grid.Column="0" Margin="0,0,3,0" Padding="3">
                    <ListBox ItemsSource="{Binding ServerLogs}"
                             FontFamily="Consolas"
                             FontSize="8.5"
                             Padding="1"
                             HorizontalContentAlignment="Stretch" />
                </GroupBox>

                <GroupBox Header="Status Log" Grid.Column="1" Margin="3,0,0,0" Padding="3">
                    <ListBox ItemsSource="{Binding StatusLogs}"
                             FontFamily="Consolas"
                             FontSize="8.5"
                             Padding="1"
                             HorizontalContentAlignment="Stretch" />
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
