<Window x:Class="RfidVehicleAccess.ServerPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS v0.1 - Server Panel"
        Icon="Assets/RealTechiAWS.ico"
        Width="940" Height="640"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="RealTech iAWS - Server Panel" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Edit target weight, all four cameras, device identity and server connection settings." Foreground="#4B5563"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Device &amp; Weight">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="Device Identity" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Text="Site ID" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="SiteIdTextBox" Grid.Row="0" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="1" Text="Device ID" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="DeviceIdTextBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="2" Text="Lane ID" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="LaneIdTextBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="3" Text="Device Name" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="DeviceNameTextBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Single Weighbridge Processing" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Text="Target Weight (KG)" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="TargetWeightTextBox" Grid.Row="0" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Reset Weight (KG)" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ResetWeightTextBox" Grid.Row="0" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="1" Text="Weight COM" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="WeightPortComboBox" Grid.Row="1" Grid.Column="1" IsEditable="True" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Baud Rate" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="WeightBaudComboBox" Grid.Row="1" Grid.Column="3" IsEditable="True" Margin="4"/>
                                <TextBlock Grid.Row="2" Text="Data Prefix" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="WeightPrefixTextBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Unit" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="WeightUnitTextBox" Grid.Row="2" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="3" Text="Stable Read Count" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="StableReadCountTextBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Sample Input" VerticalAlignment="Center" Margin="4"/><TextBlock Grid.Row="3" Grid.Column="3" Text="wn009011 kg" FontFamily="Consolas" FontWeight="Bold" Margin="4"/>
                                <TextBlock Grid.Row="4" Text="Process Wait (sec)" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ProcessWaitTextBox" Grid.Row="4" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Barrier Delay (sec)" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="BarrierDelayTextBox" Grid.Row="4" Grid.Column="3" Margin="4"/>
                            </Grid>
                        </GroupBox>

                        <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="10">
                            <TextBlock Text="Operation: Weight reaches target → system arms → whichever IN or OUT RFID is detected first owns the complete cycle → the opposite RFID is ignored until weight falls to reset level." TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="4 Cameras">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="All camera sources are editable. Every accepted weighing transaction captures all enabled cameras." FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <GroupBox Header="Camera 1" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="Camera1EnabledCheckBox" Content="Enabled" VerticalAlignment="Center"/><TextBox x:Name="Camera1UrlTextBox" Grid.Column="1" Margin="4"/></Grid></GroupBox>
                        <GroupBox Header="Camera 2" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="Camera2EnabledCheckBox" Content="Enabled" VerticalAlignment="Center"/><TextBox x:Name="Camera2UrlTextBox" Grid.Column="1" Margin="4"/></Grid></GroupBox>
                        <GroupBox Header="Camera 3" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="Camera3EnabledCheckBox" Content="Enabled" VerticalAlignment="Center"/><TextBox x:Name="Camera3UrlTextBox" Grid.Column="1" Margin="4"/></Grid></GroupBox>
                        <GroupBox Header="Camera 4" Padding="10" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="Camera4EnabledCheckBox" Content="Enabled" VerticalAlignment="Center"/><TextBox x:Name="Camera4UrlTextBox" Grid.Column="1" Margin="4"/></Grid></GroupBox>
                        <GroupBox Header="Capture Storage" Padding="10">
                            <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Local Image Folder" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ImageFolderTextBox" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="1" Text="Image File Prefix" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="ImagePrefixTextBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Server">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="MQTT Server" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="ServerEnabledCheckBox" Grid.Row="0" Grid.ColumnSpan="2" Content="Enable server synchronization" Margin="4"/>
                                <TextBlock Grid.Row="1" Text="Broker Host" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="BrokerHostTextBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="BrokerPortTextBox" Grid.Row="1" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="2" Text="Username" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="MqttUsernameTextBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Password" VerticalAlignment="Center" Margin="4"/><PasswordBox x:Name="MqttPasswordBox" Grid.Row="2" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="3" Text="Client ID" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="MqttClientIdTextBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Use TLS" VerticalAlignment="Center" Margin="4"/><CheckBox x:Name="MqttTlsCheckBox" Grid.Row="3" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="4" Text="Publish Topic" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="PublishTopicTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="4"/>
                                <TextBlock Grid.Row="5" Text="Sync Interval (sec)" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="SyncIntervalTextBox" Grid.Row="5" Grid.Column="1" Margin="4"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Image Upload" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Mode" VerticalAlignment="Center" Margin="4"/><ComboBox x:Name="UploadModeComboBox" Grid.Column="1" Margin="4"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Sftp"/><ComboBoxItem Content="Ftp"/></ComboBox>
                                <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="UploadPortTextBox" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="1" Text="Host" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="UploadHostTextBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Remote Directory" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="RemoteDirectoryTextBox" Grid.Row="1" Grid.Column="3" Margin="4"/>
                                <TextBlock Grid.Row="2" Text="Username" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="UploadUsernameTextBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Password" VerticalAlignment="Center" Margin="4"/><PasswordBox x:Name="UploadPasswordBox" Grid.Row="2" Grid.Column="3" Margin="4"/>
                                <CheckBox x:Name="UploadTlsCheckBox" Grid.Row="3" Grid.Column="1" Content="Use TLS (FTP/FTPS)" Margin="4"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,8">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save &amp; Apply" Width="120" Margin="4" Click="SaveButton_Click"/>
            <Button Content="Close" Width="90" Margin="4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
