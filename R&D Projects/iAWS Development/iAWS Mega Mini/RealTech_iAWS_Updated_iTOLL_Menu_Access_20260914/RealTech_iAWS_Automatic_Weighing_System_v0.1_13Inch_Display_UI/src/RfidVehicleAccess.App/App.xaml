<Application x:Class="RfidVehicleAccess.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F4C81" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#C2410C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="#64748B" />
        </Style>
    </Application.Resources>
</Application>
