<Window x:Class="RfidVehicleAccess.AdminControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iAWS v0.1 - Control Panel"
        Icon="Assets/RealTechiAWS.ico"
        Width="900" Height="620" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="iAWS Control Panel" FontSize="24" FontWeight="Bold"/>
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,8,0,10">
            <TextBlock Text="Simulation sequence: send a weight at/above target first, then send either IN or OUT RFID. The first RFID wins the single weighbridge cycle; the other side is ignored until weight is reset." TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Single Weighbridge Simulation" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Simulated Weight (KG)" VerticalAlignment="Center" Margin="4"/>
                        <TextBox Grid.Column="1" Text="{Binding SimulatedWeightInput, UpdateSourceTrigger=PropertyChanged}" Margin="4" FontFamily="Consolas"/>
                        <Button Grid.Column="2" Content="Send Weight" Command="{Binding SimulateWeightCommand}" Margin="4" Padding="10,5"/>
                        <TextBlock Grid.Column="3" Text="{Binding LiveWeight}" FontSize="22" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="8,0"/>
                    </Grid>
                </GroupBox>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="IN RFID / Hardware" Padding="10" Margin="0,0,5,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox Text="{Binding InRfidInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="4"/><Button Grid.Column="1" Content="Send IN RFID" Command="{Binding SimulateInRfidCommand}" Margin="4"/></Grid>
                            <UniformGrid Columns="2"><Button Content="Open IN Barrier" Command="{Binding OpenInBarrierCommand}" Margin="4"/><Button Content="Close IN Barrier" Command="{Binding CloseInBarrierCommand}" Margin="4"/></UniformGrid>
                            <UniformGrid Columns="3"><Button Content="Red" Command="{Binding InRedCommand}" Margin="4"/><Button Content="Orange" Command="{Binding InOrangeCommand}" Margin="4"/><Button Content="Green" Command="{Binding InGreenCommand}" Margin="4"/></UniformGrid>
                            <UniformGrid Columns="3"><Button Content="Buzzer ON" Command="{Binding InBuzzerCommand}" Margin="4"/><Button Content="Buzzer OFF" Command="{Binding InBuzzerOffCommand}" Margin="4"/><Button Content="All OFF" Command="{Binding InAllOffCommand}" Margin="4"/></UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="OUT RFID / Hardware" Padding="10" Margin="5,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox Text="{Binding OutRfidInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="4"/><Button Grid.Column="1" Content="Send OUT RFID" Command="{Binding SimulateOutRfidCommand}" Margin="4"/></Grid>
                            <UniformGrid Columns="2"><Button Content="Open OUT Barrier" Command="{Binding OpenOutBarrierCommand}" Margin="4"/><Button Content="Close OUT Barrier" Command="{Binding CloseOutBarrierCommand}" Margin="4"/></UniformGrid>
                            <UniformGrid Columns="3"><Button Content="Red" Command="{Binding OutRedCommand}" Margin="4"/><Button Content="Orange" Command="{Binding OutOrangeCommand}" Margin="4"/><Button Content="Green" Command="{Binding OutGreenCommand}" Margin="4"/></UniformGrid>
                            <UniformGrid Columns="3"><Button Content="Buzzer ON" Command="{Binding OutBuzzerCommand}" Margin="4"/><Button Content="Buzzer OFF" Command="{Binding OutBuzzerOffCommand}" Margin="4"/><Button Content="All OFF" Command="{Binding OutAllOffCommand}" Margin="4"/></UniformGrid>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="3" Content="Close" Width="100" HorizontalAlignment="Right" Margin="4,12,0,0" IsCancel="True"/>
    </Grid>
</Window>
