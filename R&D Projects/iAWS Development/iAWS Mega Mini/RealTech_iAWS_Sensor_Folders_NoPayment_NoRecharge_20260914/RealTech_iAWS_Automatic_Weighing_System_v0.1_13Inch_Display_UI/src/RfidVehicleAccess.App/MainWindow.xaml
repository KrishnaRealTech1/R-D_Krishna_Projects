<Window x:Class="RfidVehicleAccess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RfidVehicleAccess.Models"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="RealTech iAWS - Automatic Weighing System"
        Icon="Assets/RealTechiAWS.ico"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="1024"
        MinHeight="640"
        Background="#EAF0F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Fixed 13-inch display card styling -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- iTOLL-style live connectivity cards: red when disconnected, green when connected. -->
        <Style x:Key="NetworkCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetworkStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetworkIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Foreground" Value="#16A34A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServerCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerPartiallyConnected}" Value="True">
                    <Setter Property="Background" Value="#FFF7ED"/>
                    <Setter Property="BorderBrush" Value="#FDBA74"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServerStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerPartiallyConnected}" Value="True">
                    <Setter Property="Foreground" Value="#C2410C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServerIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerPartiallyConnected}" Value="True">
                    <Setter Property="Foreground" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                    <Setter Property="Foreground" Value="#16A34A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HardwareCardStyle" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHardwareReady}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#86EFAC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HardwareStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHardwareReady}" Value="True">
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HardwareIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHardwareReady}" Value="True">
                    <Setter Property="Foreground" Value="#16A34A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thin vertical lamp used beside Weight / IN RFID / OUT RFID, matching the supplied reference. -->
        <Style x:Key="ConnectionStripStyle" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Margin" Value="0,1,5,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#7CFC00"/>
                    <Setter Property="BorderBrush" Value="#4D9F00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CameraStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="LIVE">
                    <Setter Property="Foreground" Value="#4ADE80"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E8F1FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact traffic signal lamps for 13-inch dashboard -->
        <Style x:Key="RedSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#35202A"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Red}">
                    <Setter Property="Fill" Value="#EF4444"/>
                    <Setter Property="Stroke" Value="#FCA5A5"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#EF4444" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrangeSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#3B2A22"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Orange}">
                    <Setter Property="Fill" Value="#F59E0B"/>
                    <Setter Property="Stroke" Value="#FCD34D"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F59E0B" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GreenSignal" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Fill" Value="#183329"/>
            <Setter Property="Stroke" Value="#475569"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:SignalLightState.Green}">
                    <Setter Property="Fill" Value="#22D36B"/>
                    <Setter Property="Stroke" Value="#A7F3D0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#22D36B" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BarrierText" TargetType="TextBlock">
            <Setter Property="Text" Value="CLOSED"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="OPEN"/>
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        13-inch fixed-display baseline:
        30px menu + minimum 300px camera/system row + minimum 210px lane row + flexible logs.
        This keeps every operational control visible on common 1366x768 13-inch panels,
        including Windows display scaling, without changing any iAWS processing logic.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="2.8*" MinHeight="300"/>
            <RowDefinition Height="1.9*" MinHeight="210"/>
            <RowDefinition Height="1.0*" MinHeight="65"/>
        </Grid.RowDefinitions>

        <!-- MENU: iTOLL-compatible menu structure and native colours -->
        <Menu Grid.Row="0" Height="25">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Logs Folder" Command="{Binding OpenLogsFolderCommand}" />
                <MenuItem Header="Open _Capture Folder" Command="{Binding OpenCaptureFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Server Panel">
                <MenuItem Header="Open Server Configuration Panel..." Click="OpenServerPanel_Click" />
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="Import Registered Vehicles from File..." Command="{Binding ImportVehiclesCommand}" />
                <MenuItem Header="Sync Registered Vehicles from API..." Command="{Binding ImportVehiclesFromApiCommand}" />
                <Separator />
                <MenuItem Header="Clear Pending Data..."
                          Command="{Binding ClearPendingDataCommand}"
                          ToolTip="Permanently delete all pending transactions and their local captured image files." />
            </MenuItem>
            <MenuItem Header="_Connectivity">
                <MenuItem Header="COM Port Settings..." Click="OpenHardwareSettings_Click" />
                <Separator />
                <MenuItem Header="Changes are saved and connected immediately" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Admin Controls">
                <MenuItem Header="Open Simulation / Hardware Test Panel..." Click="OpenAdminControls_Click" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem x:Name="AboutVersionMenuItem" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- TOP: 4 CAMERAS + SYSTEM INFORMATION -->
        <Grid Grid.Row="1" Margin="7,5,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Four editable cameras -->
            <Grid Grid.Column="0" Margin="0,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera1VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Front - CAM 1" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding InCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera2VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Rear - CAM 2" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding OutCameraStatus}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera3VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Left - CAM 3" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera3Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorder}" Background="#07101C" BorderBrush="#475569" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="Camera4VideoView"/>
                        <Border VerticalAlignment="Top" Background="#D90F172A" Padding="8,4" CornerRadius="6,6,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Right - CAM 4" Foreground="White" FontWeight="ExtraBold" FontSize="10.5" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Camera4Status}" Style="{StaticResource CameraStatusStyle}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right-side information panel: fixed row heights prevent clipping -->
            <Grid Grid.Column="1" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Branding -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="4,1" Margin="1" BorderBrush="#86EFAC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="Assets/RealTechiAWSLogo.png" Height="58" Stretch="Uniform" Margin="0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                            <TextBlock Text="RealTech iAWS" FontSize="19" FontWeight="ExtraBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="AUTOMATIC WEIGHING SYSTEM" FontSize="9.5" FontWeight="ExtraBold" Foreground="#15803D" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Date / time -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DATE" FontSize="8" Foreground="#64748B" FontWeight="ExtraBold"/>
                            <TextBlock Text="{Binding SystemDate}" FontSize="13" FontWeight="ExtraBold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TIME" FontSize="8" Foreground="#64748B" FontWeight="ExtraBold"/>
                                <TextBlock Text="{Binding SystemTime}" FontSize="13" FontWeight="ExtraBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Processed / pending -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="3,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PROCESSED" FontSize="8" FontWeight="ExtraBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="{Binding ProcessedRecords}" Foreground="#15803D" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PENDING" FontSize="8" FontWeight="ExtraBold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="{Binding PendingRecords}" Foreground="#B91C1C" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Connectivity - behavior and red/green states mirror the iTOLL dashboard. -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="33"/>
                        <RowDefinition Height="33"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NetworkCardStyle}" Padding="4,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●" Style="{StaticResource NetworkIndicatorStyle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="INTERNET" FontSize="7.5" FontWeight="ExtraBold" Foreground="#334155"/>
                                <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource NetworkStatusTextStyle}" FontSize="7.8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ServerCardStyle}" Padding="4,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●" Style="{StaticResource ServerIndicatorStyle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SERVER" FontSize="7.5" FontWeight="ExtraBold" Foreground="#334155"/>
                                <TextBlock Text="{Binding ServerStatus}" Style="{StaticResource ServerStatusTextStyle}" FontSize="7.8" TextTrimming="CharacterEllipsis" ToolTip="MQTT and image-upload endpoint reachability"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource HardwareCardStyle}" Padding="5,1" ToolTip="Use Configuration > Weighbridge / COM / Hardware to change and reconnect ports.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●" Style="{StaticResource HardwareIndicatorStyle}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="HARDWARE / COM" FontSize="7.5" FontWeight="ExtraBold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding HardwareStatus}" Style="{StaticResource HardwareStatusTextStyle}" FontSize="7.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Weight + vehicle number, matching the supplied reference layout. -->
                <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="6,2" BorderBrush="#86EFAC" BorderThickness="1.5">
                    <Grid ToolTip="{Binding WeightProcessStatus}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Weight (Kg)" FontSize="8.5" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Grid Grid.Row="1" ToolTip="{Binding WeighbridgeStatus}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ConnectionStripStyle}" Tag="{Binding IsWeighbridgeConnected}"/>
                            <Border Grid.Column="1" Background="#FFFEF8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,0">
                                <TextBlock Text="{Binding WeightDisplayValue}" FontSize="23" FontWeight="SemiBold" Foreground="#C95555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="Vehicle Number" FontSize="8.5" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Grid.Row="3" Background="#FFFEF8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="5,0">
                            <TextBlock Text="{Binding WeightVehicleNumber}" FontSize="14" FontWeight="ExtraBold" Foreground="#006400" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- SHARED WEIGHBRIDGE DIRECTION: FIRST RFID WINS -->
        <Grid Grid.Row="2" Margin="7,2,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IN LANE -->
            <Border Grid.Column="0" Background="White" BorderBrush="#7FA9E8" BorderThickness="1.5" CornerRadius="9" Margin="3,0,3,0" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="7" Background="#F6FBF5" Padding="6,2" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="13"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Vehicle Identification - IN" FontSize="8.5" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ConnectionStripStyle}" Tag="{Binding IsInRfidConnected}"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="#FFFEF8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,0">
                                <TextBlock Text="{Binding InRfid}" FontSize="15" FontWeight="SemiBold" Foreground="#C95555" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal and buzzer -->
                        <Border Grid.Column="0" BorderBrush="#D6E0EC" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="5" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIGNAL" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Width="44" Height="74" CornerRadius="14" Background="#111827" BorderBrush="#475569" BorderThickness="2" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding InSignalState}"/>
                                        <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding InSignalState}"/>
                                        <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding InSignalState}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="3,1" Margin="3,1,3,0" Tag="{Binding IsInBuzzerActive}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F1E5C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0C2"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="BUZZER" FontSize="7" FontWeight="ExtraBold" Foreground="#A16207" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="🔔" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center" Tag="{Binding IsInBuzzerActive}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7A64A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#F59E0B" BlurRadius="7" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- IN barrier. Larger internal drawing area prevents the raised arm from clipping. -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1.5" Padding="5" Tag="{Binding IsInBarrierOpen}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF9F9"/>
                                    <Setter Property="BorderBrush" Value="#F1A2A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#F5FFF8"/>
                                            <Setter Property="BorderBrush" Value="#86D8A2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="13"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="IN BARRIER" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="3,0">
                                    <Canvas Width="190" Height="110" ClipToBounds="False">
                                        <Rectangle Width="14" Height="40" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="18" Canvas.Top="64"/>
                                        <Rectangle Width="28" Height="7" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="11" Canvas.Top="100"/>
                                        <Ellipse Width="16" Height="16" Fill="#56657A" Stroke="#263345" StrokeThickness="2" Canvas.Left="17" Canvas.Top="82"/>
                                        <Ellipse Width="5" Height="5" Fill="White" Canvas.Left="22.5" Canvas.Top="87.5"/>
                                        <Grid Width="112" Height="10" Canvas.Left="30" Canvas.Top="85" RenderTransformOrigin="0,0.5" Tag="{Binding IsInBarrierOpen}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-48"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.65"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="6" Background="#E52B2F" CornerRadius="2" BorderBrush="#BB1F24" BorderThickness="1"/>
                                            <Rectangle Grid.Column="1" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="3" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="5" Fill="White" Margin="0,1"/>
                                        </Grid>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="2" Style="{StaticResource BarrierText}" Tag="{Binding IsInBarrierOpen}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="3,2,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding InAccessStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="7,1" Margin="7,0,0,0">
                            <TextBlock Text="{Binding InVehicleNumber}" FontWeight="ExtraBold" FontSize="9" Foreground="#0F172A"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- OUT LANE -->
            <Border Grid.Column="1" Background="White" BorderBrush="#A99BEF" BorderThickness="1.5" CornerRadius="9" Margin="3,0,3,0" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="7" Background="#F6FBF5" Padding="6,2" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="13"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Vehicle Identification - OUT" FontSize="8.5" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ConnectionStripStyle}" Tag="{Binding IsOutRfidConnected}"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="#FFFEF8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="6,0">
                                <TextBlock Text="{Binding OutRfid}" FontSize="15" FontWeight="SemiBold" Foreground="#C95555" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Signal and buzzer -->
                        <Border Grid.Column="0" BorderBrush="#D6E0EC" BorderThickness="1" CornerRadius="8" Background="#FBFDFF" Padding="5" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="11"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="27"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="SIGNAL" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Width="44" Height="74" CornerRadius="14" Background="#111827" BorderBrush="#475569" BorderThickness="2" Padding="5,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource RedSignal}" Tag="{Binding OutSignalState}"/>
                                        <Ellipse Style="{StaticResource OrangeSignal}" Tag="{Binding OutSignalState}"/>
                                        <Ellipse Style="{StaticResource GreenSignal}" Tag="{Binding OutSignalState}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="3,1" Margin="3,1,3,0" Tag="{Binding IsOutBuzzerActive}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFBEB"/>
                                            <Setter Property="BorderBrush" Value="#F1E5C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Background" Value="#FFF0C2"/>
                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="BUZZER" FontSize="7" FontWeight="ExtraBold" Foreground="#A16207" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="🔔" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center" Tag="{Binding IsOutBuzzerActive}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D7A64A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#F59E0B" BlurRadius="7" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- OUT barrier -->
                        <Border Grid.Column="1" CornerRadius="8" BorderThickness="1.5" Padding="5" Tag="{Binding IsOutBarrierOpen}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFF9F9"/>
                                    <Setter Property="BorderBrush" Value="#F1A2A6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="#F5FFF8"/>
                                            <Setter Property="BorderBrush" Value="#86D8A2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="13"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="OUT BARRIER" FontSize="8" FontWeight="ExtraBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="3,0">
                                    <Canvas Width="190" Height="110" ClipToBounds="False">
                                        <Rectangle Width="14" Height="40" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="18" Canvas.Top="64"/>
                                        <Rectangle Width="28" Height="7" RadiusX="2" RadiusY="2" Fill="#394457" Canvas.Left="11" Canvas.Top="100"/>
                                        <Ellipse Width="16" Height="16" Fill="#56657A" Stroke="#263345" StrokeThickness="2" Canvas.Left="17" Canvas.Top="82"/>
                                        <Ellipse Width="5" Height="5" Fill="White" Canvas.Left="22.5" Canvas.Top="87.5"/>
                                        <Grid Width="112" Height="10" Canvas.Left="30" Canvas.Top="85" RenderTransformOrigin="0,0.5" Tag="{Binding IsOutBarrierOpen}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                                            <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-48"/></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.67"/><ColumnDefinition Width="18.65"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="6" Background="#E52B2F" CornerRadius="2" BorderBrush="#BB1F24" BorderThickness="1"/>
                                            <Rectangle Grid.Column="1" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="3" Fill="White" Margin="0,1"/>
                                            <Rectangle Grid.Column="5" Fill="White" Margin="0,1"/>
                                        </Grid>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Row="2" Style="{StaticResource BarrierText}" Tag="{Binding IsOutBarrierOpen}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="3,2,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OutAccessStatus}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="#475569" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="7,1" Margin="7,0,0,0">
                            <TextBlock Text="{Binding OutVehicleNumber}" FontWeight="ExtraBold" FontSize="9" Foreground="#0F172A"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- LOGS -->
        <Grid Grid.Row="3" Margin="7,2,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="3" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="9,3">
                        <TextBlock Text="SERVER LOG" FontSize="9.5" FontWeight="ExtraBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ServerLogs}" FontFamily="Consolas" FontSize="8.7" BorderThickness="0" Background="White" Padding="4,2"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="3" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="9,3">
                        <TextBlock Text="STATUS LOG" FontSize="9.5" FontWeight="ExtraBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding StatusLogs}" FontFamily="Consolas" FontSize="8.7" BorderThickness="0" Background="White" Padding="4,2"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
