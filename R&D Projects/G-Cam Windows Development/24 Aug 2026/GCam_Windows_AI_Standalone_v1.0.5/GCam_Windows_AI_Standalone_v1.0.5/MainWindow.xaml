<Window x:Class="GCam.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G-Cam Windows AI Standalone" Height="900" Width="1420"
        MinHeight="720" MinWidth="1120" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="G-Cam Windows AI Standalone" FontWeight="Bold" FontSize="23"/>
                <TextBlock Text="Person • Vehicle • License Plate • Garbage • 30s Buffer • Event Evidence • Cloudflare Dashboard" Foreground="DimGray"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start" Click="Start_Click"/>
                <Button Content="Stop" Click="Stop_Click"/>
                <Button Content="Save Settings" Click="Save_Click"/>
                <Button Content="Web Dashboard" Click="OpenLocalDashboard_Click"/>
                <Button Content="Open Evidence" Click="OpenEvidence_Click"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Live / AI">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Background="Black">
                        <Image x:Name="LiveImage" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <GroupBox Header="Runtime Status" Margin="0,0,0,8">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="CameraStatusText" Text="Camera: stopped" TextWrapping="Wrap"/>
                                <TextBlock x:Name="BufferStatusText" Text="Buffer: stopped" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ModelStatusText" Text="Models: not loaded" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetectionStatusText" Text="Detections: 0 | Events: 0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CloudflareRuntimeStatusText" Text="Dashboard: stopped | Tunnel: stopped" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Latest Event">
                            <TextBlock x:Name="LatestEventText" Margin="8" Text="No events" TextWrapping="Wrap"/>
                        </GroupBox>
                        <GroupBox Header="Detection Notes" Margin="0,8,0,0">
                            <TextBlock Margin="8" TextWrapping="Wrap">Detection delay requires an object to remain visible for the configured number of seconds before an event fires. Cooldown prevents repeated evidence for the same persistent object.</TextBlock>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Detection Controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Per-event enable/disable, delay, warning audio, image capture and video capture" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <DataGrid x:Name="EventSettingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="270">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Event" Binding="{Binding Name}" IsReadOnly="True" Width="130"/>
                                <DataGridCheckBoxColumn Header="Detection" Binding="{Binding Settings.DetectionEnabled}" Width="90"/>
                                <DataGridTextColumn Header="Delay (s)" Binding="{Binding Settings.DetectionDelaySeconds}" Width="90"/>
                                <DataGridTextColumn Header="Cooldown (s)" Binding="{Binding Settings.CooldownSeconds}" Width="100"/>
                                <DataGridCheckBoxColumn Header="Warning" Binding="{Binding Settings.WarningAudioEnabled}" Width="90"/>
                                <DataGridCheckBoxColumn Header="Image" Binding="{Binding Settings.ImageCaptureEnabled}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Video" Binding="{Binding Settings.VideoCaptureEnabled}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <CheckBox x:Name="WarningMasterCheck" Content="Master Warning Audio Enabled"/>
                        <GroupBox Header="Event Capture Test" Margin="0,16,0,0">
                            <StackPanel Margin="8">
                                <TextBlock Text="These buttons bypass AI and test image/video evidence capture using the current live frame. Start runtime first; video completes after the configured post-event time." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Test Person Event" Click="TestPerson_Click"/>
                                    <Button Content="Test Vehicle Event" Click="TestVehicle_Click"/>
                                    <Button Content="Test LPD Event" Click="TestLpd_Click"/>
                                    <Button Content="Test Garbage Event" Click="TestGarbage_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Camera / Recording">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Live / AI RTSP URL" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="LiveRtspText"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Evidence / Buffer RTSP URL" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EvidenceRtspText"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Rolling Buffer Seconds" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="BufferSecondsText"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Buffer Segment Seconds" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SegmentSecondsText"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Pre-event Seconds" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="PreSecondsText"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Post-event Seconds" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="PostSecondsText"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Evidence Root Folder" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="EvidenceRootText"/>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Person/Vehicle ONNX" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="PvModelText"/>
                    <TextBlock Grid.Row="1" Text="COCO Labels" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="PvLabelsText"/>
                    <TextBlock Grid.Row="2" Text="License Plate ONNX" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="PlateModelText"/>
                    <TextBlock Grid.Row="3" Text="License Plate Labels" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="PlateLabelsText"/>
                    <TextBlock Grid.Row="4" Text="Garbage ONNX" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="GarbageModelText"/>
                    <TextBlock Grid.Row="5" Text="Garbage Labels" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="GarbageLabelsText"/>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="Server Upload">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="UploadEnabledCheck" Content="Enable SFTP evidence upload"/>
                    <TextBlock Grid.Row="1" Text="SFTP Host" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="SftpHostText"/>
                    <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="SftpPortText"/>
                    <TextBlock Grid.Row="3" Text="Username" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="SftpUserText"/>
                    <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center"/><PasswordBox Grid.Row="4" Grid.Column="1" x:Name="SftpPasswordText" Margin="4" Padding="5"/>
                    <TextBlock Grid.Row="5" Text="Remote Base Directory" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="SftpBaseText"/>
                </Grid>
            </TabItem>

            <TabItem Header="Cloudflare / Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Local Web Dashboard + Cloudflare Tunnel" FontWeight="Bold" FontSize="18" Margin="0,0,0,6"/>
                        <TextBlock Text="This reproduces the old Python Flask/Cloudflare pattern on Windows. Cloudflare should route your hostname to http://localhost:8080 (or the port below)." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,12"/>

                        <GroupBox Header="Local Dashboard" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="DashboardEnabledCheck" Content="Enable local web dashboard"/>
                                <TextBlock Grid.Row="1" Text="Bind Address" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="DashboardBindText" ToolTip="0.0.0.0 for LAN + Cloudflare, 127.0.0.1 for local/Cloudflare only"/>
                                <TextBlock Grid.Row="2" Text="Dashboard Port" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="DashboardPortText"/>
                                <TextBlock Grid.Row="3" Text="Control API Key" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="DashboardApiKeyText"/>
                                <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Button Content="Start / Restart Dashboard" Click="StartDashboard_Click"/>
                                    <Button Content="Open Local Dashboard" Click="OpenLocalDashboard_Click"/>
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Permanent Cloudflare Tunnel">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="TunnelEnabledCheck" Content="Enable Cloudflare Tunnel"/>
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="TunnelAutoStartCheck" Content="Auto-start tunnel when G-Cam opens"/>
                                <TextBlock Grid.Row="2" Text="Public Base URL" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="PublicBaseUrlText" ToolTip="Example: https://rtgcamx.example.com"/>
                                <TextBlock Grid.Row="3" Text="Protocol" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="TunnelProtocolText" ToolTip="auto, http2 or quic"/>
                                <TextBlock Grid.Row="4" Text="Metrics Port" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="TunnelMetricsPortText"/>
                                <TextBlock Grid.Row="5" Text="Tunnel Token / Add Replica Command" VerticalAlignment="Center"/><PasswordBox Grid.Row="5" Grid.Column="1" x:Name="TunnelTokenPassword" Margin="4" Padding="5" ToolTip="Paste token or full cloudflared service install command. Leave blank to keep saved token."/>
                                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="TunnelTokenStatusText" Foreground="DimGray" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                <WrapPanel Grid.Row="7" Grid.ColumnSpan="2">
                                    <Button Content="Save + Start Tunnel" Click="StartTunnel_Click"/>
                                    <Button Content="Stop Tunnel" Click="StopTunnel_Click"/>
                                    <Button Content="Open Public Dashboard" Click="OpenPublicDashboard_Click"/>
                                    <Button Content="Forget Saved Token" Click="ForgetTunnelToken_Click"/>
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Status" Margin="0,10,0,0">
                            <TextBlock x:Name="CloudflareStatusText" Margin="10" Text="Dashboard: stopped | Tunnel: stopped" TextWrapping="Wrap"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Events">
                <DataGrid x:Name="EventsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="FooterText" Margin="2,7,2,0" Foreground="DimGray" Text="Stopped"/>
    </Grid>
</Window>
