<Window x:Class="RfidVehicleAccess.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RfidVehicleAccess.Models"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="RealTech iTOLL Automation"
        Icon="pack://application:,,,/Assets/RealTechiTollAutomation.ico"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="720"
        SizeToContent="Manual"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8E0EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SmallHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LaneAccessStatusBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static models:LaneState.VehicleDetected}">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static models:LaneState.Processing}">
                    <Setter Property="Background" Value="#FFF7ED" />
                    <Setter Property="BorderBrush" Value="#FDBA74" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static models:LaneState.Approved}">
                    <Setter Property="Background" Value="#DCFCE7" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static models:LaneState.Rejected}">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                             Value="{x:Static models:LaneState.Error}">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetworkCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource DashboardCardStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetworkStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Foreground" Value="#15803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NetworkIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Foreground" Value="#16A34A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServerCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource DashboardCardStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerPartiallyConnected}" Value="True">
                    <Setter Property="Background" Value="#FFF7ED" />
                    <Setter Property="BorderBrush" Value="#FDBA74" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServerStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerPartiallyConnected}" Value="True">
                    <Setter Property="Foreground" Value="#C2410C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                    <Setter Property="Foreground" Value="#15803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ServerIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsServerPartiallyConnected}" Value="True">
                    <Setter Property="Foreground" Value="#F97316" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                    <Setter Property="Foreground" Value="#16A34A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HardwareCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource DashboardCardStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHardwareReady}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalRedLightStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#7F1D1D" />
            <Setter Property="Stroke" Value="#991B1B" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.22" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                   Value="{x:Static models:SignalLightState.Red}" />
                        <Condition Binding="{Binding IsRedFrontendEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="#FF3B3B" />
                    <Setter Property="Stroke" Value="#FCA5A5" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF3B3B" BlurRadius="18" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalOrangeLightStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#7C2D12" />
            <Setter Property="Stroke" Value="#9A3412" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.22" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                   Value="{x:Static models:SignalLightState.Orange}" />
                        <Condition Binding="{Binding IsOrangeFrontendEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="#FF9F0A" />
                    <Setter Property="Stroke" Value="#FED7AA" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF9F0A" BlurRadius="18" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SignalGreenLightStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#14532D" />
            <Setter Property="Stroke" Value="#166534" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Opacity" Value="0.22" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                   Value="{x:Static models:SignalLightState.Green}" />
                        <Condition Binding="{Binding IsGreenFrontendEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="#20D760" />
                    <Setter Property="Stroke" Value="#BBF7D0" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#20D760" BlurRadius="18" ShadowDepth="0" Opacity="1" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="BuzzerIndicatorStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Opacity" Value="0.38" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsBuzzerFrontendEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFF7ED" />
                    <Setter Property="BorderBrush" Value="#F59E0B" />
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F59E0B"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InBarrierCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource InnerCardStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInBarrierOpen}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutBarrierCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource InnerCardStyle}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutBarrierOpen}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5" />
                    <Setter Property="BorderBrush" Value="#86EFAC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InBarrierStatusStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="CLOSED" />
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInBarrierOpen}" Value="True">
                    <Setter Property="Text" Value="OPEN" />
                    <Setter Property="Foreground" Value="#15803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutBarrierStatusStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="CLOSED" />
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutBarrierOpen}" Value="True">
                    <Setter Property="Text" Value="OPEN" />
                    <Setter Property="Foreground" Value="#15803D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InBarrierArmStyle" TargetType="Grid">
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInBarrierOpen}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="-62" /></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutBarrierArmStyle" TargetType="Grid">
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutBarrierOpen}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="-62" /></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top" Height="25">
            <MenuItem Header="_File">
                <MenuItem Header="Open Capture _Folder" Command="{Binding OpenCaptureFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Server Panel">
                <MenuItem Header="Open Server Configuration Panel..." Click="OpenServerPanel_Click" />
            </MenuItem>
            <MenuItem Header="_Payment Configuration">
                <MenuItem Header="Manage Vehicle Categories and Prices..." Click="OpenPaymentConfiguration_Click" />
            </MenuItem>
            <MenuItem Header="_Data">
                <MenuItem Header="Import Registered Vehicles from File..." Command="{Binding ImportVehiclesCommand}" />
                <MenuItem Header="Sync Registered Vehicles from API..." Command="{Binding ImportVehiclesFromApiCommand}" />
                <Separator />
                <MenuItem Header="Open Logs and Images Folder" Command="{Binding OpenCaptureFolderCommand}" />
                <Separator />
                <MenuItem Header="Clear Pending Data..."
                          Command="{Binding ClearPendingDataCommand}"
                          ToolTip="Permanently delete all pending transactions and their local images." />
            </MenuItem>
            <MenuItem Header="_Connectivity">
                <MenuItem Header="COM Port Settings..." Click="OpenHardwareSettings_Click" />
                <Separator />
                <MenuItem Header="Changes are saved and connected immediately" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Admin Controls">
                <MenuItem Header="Open Simulation / Hardware Test Panel..." Click="OpenAdminControls_Click" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem x:Name="AboutVersionMenuItem" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="470" />
                <RowDefinition Height="190" MinHeight="160" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220" />
                    <RowDefinition Height="*" MinHeight="220" />
                </Grid.RowDefinitions>

                <!-- Separate IN flow row -->
                <GroupBox Grid.Row="0" Header="IN FLOW" Margin="2" Padding="5" Foreground="#1D4ED8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" />
                            <ColumnDefinition Width="31*" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#475569" BorderThickness="1" Background="#0F172A" Margin="2">
                            <vlc:VideoView x:Name="InVideoView">
                                <Grid IsHitTestVisible="False">
                                    <Border Background="#B3000000" VerticalAlignment="Bottom" Margin="7" Padding="5">
                                        <TextBlock Text="{Binding InCameraStatus}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </vlc:VideoView>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InnerCardStyle}" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚙"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                        <TextBlock Text="CURRENT VEHICLE" Style="{StaticResource SmallHeadingStyle}" />
                                        <TextBlock Text="{Binding InVehicleNumber}"
                                                   Foreground="#B91C1C"
                                                   FontSize="16"
                                                   FontWeight="ExtraBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding InVehicleNumber}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#E2E8F0" />

                                <Grid Grid.Row="2" Margin="0,5,0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="RFID" FontWeight="ExtraBold" Foreground="#334155" FontSize="10.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="TYPE" FontWeight="ExtraBold" Foreground="#334155" FontSize="10.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="BALANCE" FontWeight="ExtraBold" Foreground="#334155" FontSize="10.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InRfid}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding InRfid}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InAccessType}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding InAccessType}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InBalance}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                </Grid>

                                <Border Grid.Row="3"
                                        Tag="{Binding InLaneState}"
                                        Style="{StaticResource LaneAccessStatusBorderStyle}"
                                        ToolTip="{Binding InAccessStatus}">
                                    <TextBlock Text="{Binding InAccessStatus}"
                                               Foreground="#0F172A"
                                               FontSize="9.5"
                                               FontWeight="ExtraBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}" Padding="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="108" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="SIGNAL" Foreground="#475569" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                <Border Grid.Row="1"
                                        Width="46"
                                        Height="108"
                                        Background="#1E293B"
                                        BorderBrush="#0F172A"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Width="24" Height="24" Margin="0,4" Tag="{Binding InSignalState}" Style="{StaticResource SignalRedLightStyle}" />
                                        <Ellipse Width="24" Height="24" Margin="0,4" Tag="{Binding InSignalState}" Style="{StaticResource SignalOrangeLightStyle}" />
                                        <Ellipse Width="24" Height="24" Margin="0,4" Tag="{Binding InSignalState}" Style="{StaticResource SignalGreenLightStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2"
                                        Width="58"
                                        Height="42"
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Tag="{Binding IsInBuzzerActive}"
                                        Style="{StaticResource BuzzerIndicatorStyle}"
                                        ToolTip="IN buzzer activity">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="BUZZER"
                                                   Foreground="#92400E"
                                                   FontSize="7"
                                                   FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" />
                                        <Viewbox Grid.Row="1" Width="34" Height="23" HorizontalAlignment="Center">
                                            <Canvas Width="48" Height="32">
                                                <Path Data="M13,23 L16,20 L16,13 C16,7 20,3 24,3 C28,3 32,7 32,13 L32,20 L35,23 Z"
                                                      Fill="#F59E0B" Stroke="#92400E" StrokeThickness="1.4" />
                                                <Rectangle Canvas.Left="11" Canvas.Top="23" Width="26" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#92400E" />
                                                <Ellipse Canvas.Left="21" Canvas.Top="26" Width="6" Height="4" Fill="#F59E0B" Stroke="#92400E" StrokeThickness="1" />
                                                <Path Data="M9,9 L5,5 M39,9 L43,5 M8,17 L3,17 M40,17 L45,17"
                                                      Stroke="#F59E0B" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource InBarrierCardStyle}" Padding="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="IN BARRIER" Foreground="#475569" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                <Grid Grid.Row="1" Width="112" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="14" Height="35" Fill="#475569" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13,0,0,2" />
                                    <Rectangle Width="23" Height="6" Fill="#334155" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,0" />
                                    <Grid Width="80" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,29" Style="{StaticResource InBarrierArmStyle}">
                                        <Border Background="#DC2626" CornerRadius="2" />
                                        <Rectangle Width="12" Fill="White" HorizontalAlignment="Left" Margin="14,1,0,1" />
                                        <Rectangle Width="12" Fill="White" HorizontalAlignment="Left" Margin="41,1,0,1" />
                                        <Rectangle Width="10" Fill="White" HorizontalAlignment="Right" Margin="0,1,6,1" />
                                    </Grid>
                                    <Ellipse Width="12" Height="12" Fill="#F8FAFC" Stroke="#334155" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,27" />
                                </Grid>
                                <TextBlock Grid.Row="2" Style="{StaticResource InBarrierStatusStyle}" FontSize="13" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- Separate OUT flow row -->
                <GroupBox Grid.Row="1" Header="OUT FLOW" Margin="2" Padding="5" Foreground="#7C3AED">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" />
                            <ColumnDefinition Width="31*" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#475569" BorderThickness="1" Background="#0F172A" Margin="2">
                            <vlc:VideoView x:Name="OutVideoView">
                                <Grid IsHitTestVisible="False">
                                    <Border Background="#B3000000" VerticalAlignment="Bottom" Margin="7" Padding="5">
                                        <TextBlock Text="{Binding OutCameraStatus}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </vlc:VideoView>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InnerCardStyle}" Padding="7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚙"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                        <TextBlock Text="CURRENT VEHICLE" Style="{StaticResource SmallHeadingStyle}" />
                                        <TextBlock Text="{Binding OutVehicleNumber}"
                                                   Foreground="#B91C1C"
                                                   FontSize="16"
                                                   FontWeight="ExtraBold"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding OutVehicleNumber}" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#E2E8F0" />

                                <Grid Grid.Row="2" Margin="0,5,0,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="RFID" FontWeight="ExtraBold" Foreground="#334155" FontSize="10.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="TYPE" FontWeight="ExtraBold" Foreground="#334155" FontSize="10.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="BALANCE" FontWeight="ExtraBold" Foreground="#334155" FontSize="10.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OutRfid}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutRfid}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutAccessType}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutAccessType}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OutBalance}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                </Grid>

                                <Border Grid.Row="3"
                                        Tag="{Binding OutLaneState}"
                                        Style="{StaticResource LaneAccessStatusBorderStyle}"
                                        ToolTip="{Binding OutAccessStatus}">
                                    <TextBlock Text="{Binding OutAccessStatus}"
                                               Foreground="#0F172A"
                                               FontSize="9.5"
                                               FontWeight="ExtraBold"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}" Padding="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="108" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="SIGNAL" Foreground="#475569" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                <Border Grid.Row="1"
                                        Width="46"
                                        Height="108"
                                        Background="#1E293B"
                                        BorderBrush="#0F172A"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center">
                                        <Ellipse Width="24" Height="24" Margin="0,4" Tag="{Binding OutSignalState}" Style="{StaticResource SignalRedLightStyle}" />
                                        <Ellipse Width="24" Height="24" Margin="0,4" Tag="{Binding OutSignalState}" Style="{StaticResource SignalOrangeLightStyle}" />
                                        <Ellipse Width="24" Height="24" Margin="0,4" Tag="{Binding OutSignalState}" Style="{StaticResource SignalGreenLightStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2"
                                        Width="58"
                                        Height="42"
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Tag="{Binding IsOutBuzzerActive}"
                                        Style="{StaticResource BuzzerIndicatorStyle}"
                                        ToolTip="OUT buzzer activity">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="BUZZER"
                                                   Foreground="#92400E"
                                                   FontSize="7"
                                                   FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" />
                                        <Viewbox Grid.Row="1" Width="34" Height="23" HorizontalAlignment="Center">
                                            <Canvas Width="48" Height="32">
                                                <Path Data="M13,23 L16,20 L16,13 C16,7 20,3 24,3 C28,3 32,7 32,13 L32,20 L35,23 Z"
                                                      Fill="#F59E0B" Stroke="#92400E" StrokeThickness="1.4" />
                                                <Rectangle Canvas.Left="11" Canvas.Top="23" Width="26" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#92400E" />
                                                <Ellipse Canvas.Left="21" Canvas.Top="26" Width="6" Height="4" Fill="#F59E0B" Stroke="#92400E" StrokeThickness="1" />
                                                <Path Data="M9,9 L5,5 M39,9 L43,5 M8,17 L3,17 M40,17 L45,17"
                                                      Stroke="#F59E0B" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource OutBarrierCardStyle}" Padding="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="OUT BARRIER" Foreground="#475569" FontSize="9" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                <Grid Grid.Row="1" Width="112" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="14" Height="35" Fill="#475569" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="13,0,0,2" />
                                    <Rectangle Width="23" Height="6" Fill="#334155" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9,0,0,0" />
                                    <Grid Width="80" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="25,0,0,29" Style="{StaticResource OutBarrierArmStyle}">
                                        <Border Background="#DC2626" CornerRadius="2" />
                                        <Rectangle Width="12" Fill="White" HorizontalAlignment="Left" Margin="14,1,0,1" />
                                        <Rectangle Width="12" Fill="White" HorizontalAlignment="Left" Margin="41,1,0,1" />
                                        <Rectangle Width="10" Fill="White" HorizontalAlignment="Right" Margin="0,1,6,1" />
                                    </Grid>
                                    <Ellipse Width="12" Height="12" Fill="#F8FAFC" Stroke="#334155" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,27" />
                                </Grid>
                                <TextBlock Grid.Row="2" Style="{StaticResource OutBarrierStatusStyle}" FontSize="13" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

            </Grid>

            <!-- Branded status dashboard. Star-sized rows keep every card stretched and remove unused vertical gaps. -->
            <Grid Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*" MinHeight="86" />
                    <RowDefinition Height="0.72*" MinHeight="56" />
                    <RowDefinition Height="0.72*" MinHeight="56" />
                    <RowDefinition Height="0.92*" MinHeight="72" />
                    <RowDefinition Height="0.90*" MinHeight="70" />
                    <RowDefinition Height="1.55*" MinHeight="126" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="80"
                                Height="80"
                                CornerRadius="12"
                                Background="White"
                                BorderBrush="#D8E0EA"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Image Source="Assets/RealTechiTollAutomationLogo.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="8,0,2,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="REALTECH"
                                       Foreground="#0F4C81"
                                       FontSize="11"
                                       FontWeight="ExtraBold" />
                            <TextBlock Text="iTOLL AUTOMATION"
                                       Foreground="#E11D24"
                                       FontSize="17"
                                       FontWeight="ExtraBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Vehicle access control"
                                       Foreground="#64748B"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="◷" Foreground="#2563EB" FontSize="29" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM TIME" Style="{StaticResource SmallHeadingStyle}" />
                            <TextBlock Text="{Binding SystemTime}" Foreground="#1E3A8A" FontSize="21" FontWeight="ExtraBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource DashboardCardStyle}" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="PROCESSED" Style="{StaticResource SmallHeadingStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProcessedRecords}" Foreground="#15803D" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="PENDING" Style="{StaticResource SmallHeadingStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding PendingRecords}" Foreground="#B91C1C" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource NetworkCardStyle}" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●"
                                       Style="{StaticResource NetworkIndicatorStyle}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="INTERNET" Style="{StaticResource SmallHeadingStyle}" />
                                <TextBlock Text="{Binding NetworkStatus}"
                                           Style="{StaticResource NetworkStatusTextStyle}"
                                           FontSize="9.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ServerCardStyle}" Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="●"
                                       Style="{StaticResource ServerIndicatorStyle}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SERVER" Style="{StaticResource SmallHeadingStyle}" />
                                <TextBlock Text="{Binding ServerStatus}"
                                           Style="{StaticResource ServerStatusTextStyle}"
                                           ToolTip="MQTT and SFTP endpoint reachability" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource HardwareCardStyle}" ToolTip="Use Connectivity > COM Port Settings to change and reconnect ports.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚙" Foreground="#475569" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="HARDWARE / COM" Style="{StaticResource SmallHeadingStyle}" />
                            <TextBlock Text="{Binding HardwareStatus}" Foreground="#334155" FontWeight="Bold" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="5"
                        Style="{StaticResource DashboardCardStyle}"
                        Padding="8,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CAPTURE STORAGE" Style="{StaticResource SmallHeadingStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="Documents\Realtech_systems"
                                   Foreground="#0F4C81"
                                   FontWeight="ExtraBold"
                                   FontSize="11"
                                   Margin="0,4,0,2"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2"
                                   Text="Images are stored by year, month, day and lane. Status and server logs are stored in the Logs folder."
                                   Foreground="#475569"
                                   FontSize="9"
                                   LineHeight="11"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top" />
                        <Button Grid.Row="3"
                                Content="Open Folder"
                                Command="{Binding OpenCaptureFolderCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0"
                                MinHeight="26"
                                Padding="6,2"
                                FontWeight="SemiBold" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Status and server logs span the full width below the dashboard.
                 IND wired/Bluetooth failover runs silently in the background. -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Status Log" Grid.Column="0" Margin="2" Padding="3">
                    <ListBox ItemsSource="{Binding StatusLogs}"
                             FontFamily="Consolas"
                             FontSize="8.5"
                             Padding="1"
                             HorizontalContentAlignment="Stretch" />
                </GroupBox>
                <GroupBox Header="Server Log" Grid.Column="1" Margin="2" Padding="3">
                    <ListBox ItemsSource="{Binding ServerLogs}"
                             FontFamily="Consolas"
                             FontSize="8.5"
                             Padding="1"
                             HorizontalContentAlignment="Stretch" />
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
