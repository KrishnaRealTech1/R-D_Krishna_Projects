<Window x:Class="RfidVehicleAccess.AdminControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech iTOLL Automation - Admin Controls"
        Icon="pack://application:,,,/Assets/RealTechiTollAutomation.ico"
        Width="860"
        Height="720"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#E5E7EB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="AdminButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LaneHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Margin" Value="4,0,4,8" />
        </Style>
        <Style x:Key="FrontendToggleStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Admin Controls"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#0F172A" />

        <Border Grid.Row="1"
                Background="#FFF7ED"
                BorderBrush="#FDBA74"
                BorderThickness="1"
                CornerRadius="6"
                Padding="9"
                Margin="0,8,0,10">
            <TextBlock Text="Admin-only manual commands, frontend hardware indicators, and approval settings. Frontend indicator switches never block hardware commands."
                       Foreground="#9A3412"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel Margin="0,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="IN Flow Controls" Margin="0,0,6,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="IN" Foreground="#1D4ED8" Style="{StaticResource LaneHeadingStyle}" />

                            <UniformGrid Grid.Row="1" Columns="4">
                                <Button Content="Sensor HIGH" Command="{Binding SimulateInSensorHighCommand}" Style="{StaticResource AdminButtonStyle}" />
                                <Button Content="Send Realeased" Command="{Binding SimulateInReleasedCommand}" Style="{StaticResource AdminButtonStyle}" />
                                <Button Content="Open Barrier" Command="{Binding OpenInBarrierCommand}" Style="{StaticResource AdminButtonStyle}" Background="#DCFCE7" />
                                <Button Content="Close Barrier" Command="{Binding CloseInBarrierCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FEE2E2" />
                            </UniformGrid>

                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                                <Button Content="Red Signal" Command="{Binding InRedCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FEE2E2" />
                                <Button Content="Orange Signal" Command="{Binding InOrangeCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FFEDD5" />
                                <Button Content="Green Signal" Command="{Binding InGreenCommand}" Style="{StaticResource AdminButtonStyle}" Background="#DCFCE7" />
                            </UniformGrid>

                            <UniformGrid Grid.Row="3" Columns="3">
                                <Button Content="Buzzer ON" Command="{Binding InBuzzerCommand}" Style="{StaticResource AdminButtonStyle}" Background="#DCFCE7" />
                                <Button Content="Buzzer OFF" Command="{Binding InBuzzerOffCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FEE2E2" />
                                <Button Content="All Outputs Off" Command="{Binding InAllOffCommand}" Style="{StaticResource AdminButtonStyle}" />
                            </UniformGrid>

                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding InRfidInput, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="38"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Consolas"
                                         ToolTip="Enter an IN RFID value" />
                                <Button Grid.Column="1"
                                        Content="Send RFID"
                                        Command="{Binding SimulateInRfidCommand}"
                                        Style="{StaticResource AdminButtonStyle}" />
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="OUT Flow Controls" Margin="6,0,0,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="OUT" Foreground="#7C3AED" Style="{StaticResource LaneHeadingStyle}" />

                            <UniformGrid Grid.Row="1" Columns="4">
                                <Button Content="Sensor HIGH" Command="{Binding SimulateOutSensorHighCommand}" Style="{StaticResource AdminButtonStyle}" />
                                <Button Content="Send Realeased" Command="{Binding SimulateOutReleasedCommand}" Style="{StaticResource AdminButtonStyle}" />
                                <Button Content="Open Barrier" Command="{Binding OpenOutBarrierCommand}" Style="{StaticResource AdminButtonStyle}" Background="#DCFCE7" />
                                <Button Content="Close Barrier" Command="{Binding CloseOutBarrierCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FEE2E2" />
                            </UniformGrid>

                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                                <Button Content="Red Signal" Command="{Binding OutRedCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FEE2E2" />
                                <Button Content="Orange Signal" Command="{Binding OutOrangeCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FFEDD5" />
                                <Button Content="Green Signal" Command="{Binding OutGreenCommand}" Style="{StaticResource AdminButtonStyle}" Background="#DCFCE7" />
                            </UniformGrid>

                            <UniformGrid Grid.Row="3" Columns="3">
                                <Button Content="Buzzer ON" Command="{Binding OutBuzzerCommand}" Style="{StaticResource AdminButtonStyle}" Background="#DCFCE7" />
                                <Button Content="Buzzer OFF" Command="{Binding OutBuzzerOffCommand}" Style="{StaticResource AdminButtonStyle}" Background="#FEE2E2" />
                                <Button Content="All Outputs Off" Command="{Binding OutAllOffCommand}" Style="{StaticResource AdminButtonStyle}" />
                            </UniformGrid>

                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutRfidInput, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="38"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Consolas"
                                         ToolTip="Enter an OUT RFID value" />
                                <Button Grid.Column="1"
                                        Content="Send RFID"
                                        Command="{Binding SimulateOutRfidCommand}"
                                        Style="{StaticResource AdminButtonStyle}" />
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>

                <GroupBox Header="Frontend (UI) Hardware Control"
                          Margin="0,12,0,0"
                          Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Enable or disable only the dashboard indicators. IN/OUT RED, GREEN, ORANGE, and BUZZER commands continue to be sent to the control unit as usual."
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="4,0,4,6" />

                        <UniformGrid Grid.Row="1" Columns="4">
                            <CheckBox Content="Enable RED"
                                      IsChecked="{Binding IsRedFrontendEnabled, Mode=TwoWay}"
                                      Foreground="#B91C1C"
                                      Style="{StaticResource FrontendToggleStyle}" />
                            <CheckBox Content="Enable GREEN"
                                      IsChecked="{Binding IsGreenFrontendEnabled, Mode=TwoWay}"
                                      Foreground="#15803D"
                                      Style="{StaticResource FrontendToggleStyle}" />
                            <CheckBox Content="Enable ORANGE"
                                      IsChecked="{Binding IsOrangeFrontendEnabled, Mode=TwoWay}"
                                      Foreground="#C2410C"
                                      Style="{StaticResource FrontendToggleStyle}" />
                            <CheckBox Content="Enable BUZZER"
                                      IsChecked="{Binding IsBuzzerFrontendEnabled, Mode=TwoWay}"
                                      Foreground="#92400E"
                                      Style="{StaticResource FrontendToggleStyle}" />
                        </UniformGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Exceptional Approval Popup Controls"
                          Margin="0,10,0,0"
                          Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4,0,12,0">
                            <CheckBox Content="Enable IN Exceptional Approval Popup"
                                      IsChecked="{Binding IsInExceptionalApprovalEnabled, Mode=TwoWay}"
                                      FontWeight="SemiBold"
                                      FontSize="14" />
                            <TextBlock Text="When IN auto approval is off, show the approval popup for a missing OUT trip."
                                       Margin="22,4,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                            <CheckBox Content="Enable OUT Exceptional Approval Popup"
                                      IsChecked="{Binding IsOutExceptionalApprovalEnabled, Mode=TwoWay}"
                                      FontWeight="SemiBold"
                                      FontSize="14" />
                            <TextBlock Text="When OUT auto approval is off, show the approval popup for a missing IN trip."
                                       Margin="22,4,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Auto Approval Controls"
                          Margin="0,10,0,4"
                          Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4,0,12,0">
                            <CheckBox Content="Auto Approve IN Missing OUT"
                                      IsChecked="{Binding IsInAutoApprovalEnabled, Mode=TwoWay}"
                                      FontWeight="SemiBold"
                                      FontSize="14" />
                            <TextBlock Text="Skips the popup, reconciles the missing OUT trip, and processes the current IN trip."
                                       Margin="22,4,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                            <CheckBox Content="Auto Approve OUT Missing IN"
                                      IsChecked="{Binding IsOutAutoApprovalEnabled, Mode=TwoWay}"
                                      FontWeight="SemiBold"
                                      FontSize="14" />
                            <TextBlock Text="Skips the popup, reconciles the missing IN trip, and processes the current OUT trip."
                                       Margin="22,4,0,0"
                                       Foreground="#475569"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Save applies frontend switches and approval settings immediately."
                       Foreground="#475569"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Content="Save Settings"
                    Command="{Binding SaveAdminSettingsCommand}"
                    Style="{StaticResource AdminButtonStyle}"
                    Background="#DBEAFE"
                    MinWidth="135" />

            <Button Grid.Column="2"
                    Content="Close"
                    MinWidth="100"
                    Style="{StaticResource AdminButtonStyle}"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
