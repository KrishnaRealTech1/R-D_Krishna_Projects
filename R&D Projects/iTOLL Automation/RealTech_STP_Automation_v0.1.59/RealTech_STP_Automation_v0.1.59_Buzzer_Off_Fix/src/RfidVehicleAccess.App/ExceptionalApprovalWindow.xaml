<Window x:Class="RfidVehicleAccess.ExceptionalApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTech STP Automation - Exceptional Approval"
        Icon="pack://application:,,,/Assets/RealTechStpAutomation.ico"
        Width="560"
        MinWidth="540"
        MinHeight="575"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Exceptional Approval Required"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#991B1B" />

        <Border Grid.Row="1"
                Margin="0,10,0,18"
                Padding="13"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel>
                <TextBlock x:Name="MissingTripTitleText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#B91C1C" />
                <TextBlock x:Name="ExplanationText"
                           Margin="0,5,0,0"
                           Foreground="#7F1D1D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Lane" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock x:Name="LaneText" Grid.Row="0" Grid.Column="1" FontWeight="Bold" Foreground="#0F172A" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,7,0,0" Text="Vehicle Number" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock x:Name="VehicleNumberText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" FontWeight="Bold" Foreground="#0F172A" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,7,0,0" Text="RFID Number" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock x:Name="RfidNumberText" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" Foreground="#0F172A" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,7,0,0" Text="Access Type" FontWeight="SemiBold" Foreground="#334155" />
            <TextBlock x:Name="AccessTypeText" Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" Foreground="#0F172A" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Approver Name"
                   FontWeight="SemiBold"
                   Foreground="#1E293B" />
        <TextBox x:Name="ApproverNameTextBox"
                 Grid.Row="4"
                 Height="40"
                 Margin="0,5,0,12"
                 Padding="8,5"
                 FontSize="15"
                 MaxLength="100"
                 ToolTip="Enter alphabets and spaces only."
                 PreviewTextInput="ApproverNameTextBox_PreviewTextInput"
                 DataObject.Pasting="ApproverNameTextBox_Pasting"
                 TextChanged="ApprovalInput_TextChanged" />

        <TextBlock Grid.Row="5"
                   Text="Role"
                   FontWeight="SemiBold"
                   Foreground="#1E293B" />
        <TextBox x:Name="RoleTextBox"
                 Grid.Row="6"
                 Height="40"
                 Margin="0,5,0,12"
                 Padding="8,5"
                 FontSize="15"
                 MaxLength="100"
                 TextChanged="ApprovalInput_TextChanged" />

        <TextBlock Grid.Row="7"
                   Text="Mobile Number"
                   FontWeight="SemiBold"
                   Foreground="#1E293B" />
        <TextBox x:Name="MobileNumberTextBox"
                 Grid.Row="8"
                 Height="40"
                 Margin="0,5,0,0"
                 Padding="8,5"
                 FontSize="15"
                 MaxLength="10"
                 ToolTip="Enter exactly 10 digits."
                 InputMethod.IsInputMethodEnabled="False"
                 PreviewTextInput="MobileNumberTextBox_PreviewTextInput"
                 DataObject.Pasting="MobileNumberTextBox_Pasting"
                 TextChanged="ApprovalInput_TextChanged" />

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="9"
                   Margin="0,9,0,0"
                   Foreground="#B91C1C"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <TextBlock Grid.Row="10"
                   Margin="0,14,0,0"
                   Text="Submitting this approval creates reconciliation records for the missing trip and allows the current vehicle movement to continue."
                   Foreground="#475569"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="11"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="105"
                    Height="40"
                    Padding="12,6"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="Exceptional Approval"
                    Width="190"
                    Height="40"
                    Padding="12,6"
                    IsDefault="True"
                    Click="ExceptionalApproval_Click"
                    Background="#B91C1C"
                    Foreground="White"
                    FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
