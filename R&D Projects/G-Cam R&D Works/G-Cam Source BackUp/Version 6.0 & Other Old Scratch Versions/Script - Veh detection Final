<script>
// ============ GEOFENCE EDITOR ============
const geoCanvas = document.getElementById('geoCanvas');
const geoCtx = geoCanvas.getContext('2d');
let geoImg = new Image();
let geoRect = null;      // {x1,y1,x2,y2} in canvas pixels
let geoDrawing = false;
let geoStart = null;
let geoCurrentRoi = null; // saved ratios from server

function geoCanvasPos(e) {
  const r = geoCanvas.getBoundingClientRect();
  const scaleX = geoCanvas.width / r.width;
  const scaleY = geoCanvas.height / r.height;
  const clientX = e.touches ? e.touches[0].clientX : e.clientX;
  const clientY = e.touches ? e.touches[0].clientY : e.clientY;
  return {
    x: (clientX - r.left) * scaleX,
    y: (clientY - r.top)  * scaleY
  };
}

function geoRedraw() {
  geoCtx.drawImage(geoImg, 0, 0, geoCanvas.width, geoCanvas.height);

  // Darken outside zone
  if (geoRect) {
    const {x1,y1,x2,y2} = geoRect;
    geoCtx.fillStyle = 'rgba(0,0,0,0.45)';
    geoCtx.fillRect(0, 0, geoCanvas.width, y1);
    geoCtx.fillRect(0, y2, geoCanvas.width, geoCanvas.height - y2);
    geoCtx.fillRect(0, y1, x1, y2 - y1);
    geoCtx.fillRect(x2, y1, geoCanvas.width - x2, y2 - y1);

    // Draw box
    geoCtx.strokeStyle = '#39c6ff';
    geoCtx.lineWidth = 2.5;
    geoCtx.setLineDash([6, 3]);
    geoCtx.strokeRect(x1, y1, x2 - x1, y2 - y1);
    geoCtx.setLineDash([]);

    // Label
    geoCtx.fillStyle = '#39c6ff';
    geoCtx.font = 'bold 13px Arial';
    geoCtx.fillText('Garbage Zone', x1 + 6, y1 + 18);

    // Update ratio display
