<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GCam.Windows</AssemblyName>
    <RootNamespace>GCam.Windows</RootNamespace>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <ApplicationIcon Condition="Exists('assets\\gcam.ico')">assets\gcam.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.19.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20240616" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="models\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('tools\ffmpeg.exe')" />
    <EmbeddedResource Include="tools\ffmpeg.exe" LogicalName="GCam.Windows.Resources.ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')" />
    <None Update="tools\cloudflared.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('tools\cloudflared.exe')" />
    <EmbeddedResource Include="tools\cloudflared.exe" LogicalName="GCam.Windows.Resources.cloudflared.exe" Condition="Exists('tools\cloudflared.exe')" />
    <EmbeddedResource Include="models\MobileNetSSD_deploy.prototxt" LogicalName="GCam.Windows.Resources.MobileNetSSD_deploy.prototxt" Condition="Exists('models\MobileNetSSD_deploy.prototxt')" />
    <EmbeddedResource Include="models\MobileNetSSD_deploy.caffemodel" LogicalName="GCam.Windows.Resources.MobileNetSSD_deploy.caffemodel" Condition="Exists('models\MobileNetSSD_deploy.caffemodel')" />
  </ItemGroup>
</Project>
