{
  "Camera": {
    "LiveRtspUrl": "rtsp://user:password@camera-ip:554/substream",
    "EvidenceRtspUrl": "rtsp://user:password@camera-ip:554/mainstream",
    "PreviewWidth": 960,
    "DetectionFps": 5
  },
  "Ai": {
    "PersonVehicle": {
      "Enabled": true,
      "ModelPath": "models/person_vehicle.onnx",
      "LabelsPath": "models/coco80.txt",
      "Confidence": 0.5,
      "NmsThreshold": 0.45,
      "InputSize": 640,
      "UseDirectMl": true
    },
    "LicensePlate": {
      "Enabled": true,
      "ModelPath": "models/license_plate.onnx",
      "LabelsPath": "models/license_plate.txt",
      "Confidence": 0.5,
      "NmsThreshold": 0.45,
      "InputSize": 640,
      "UseDirectMl": true
    },
    "Garbage": {
      "Enabled": true,
      "ModelPath": "models/garbage.onnx",
      "LabelsPath": "models/garbage.txt",
      "Confidence": 0.5,
      "NmsThreshold": 0.45,
      "InputSize": 640,
      "UseDirectMl": true
    },
    "Person": {
      "DetectionEnabled": true,
      "DetectionDelaySeconds": 1.5,
      "CooldownSeconds": 15,
      "WarningAudioEnabled": true,
      "ImageCaptureEnabled": true,
      "VideoCaptureEnabled": true
    },
    "Vehicle": {
      "DetectionEnabled": true,
      "DetectionDelaySeconds": 2.0,
      "CooldownSeconds": 15,
      "WarningAudioEnabled": true,
      "ImageCaptureEnabled": true,
      "VideoCaptureEnabled": true
    },
    "LicensePlateEvent": {
      "DetectionEnabled": true,
      "DetectionDelaySeconds": 0.5,
      "CooldownSeconds": 10,
      "WarningAudioEnabled": false,
      "ImageCaptureEnabled": true,
      "VideoCaptureEnabled": true
    },
    "GarbageEvent": {
      "DetectionEnabled": true,
      "DetectionDelaySeconds": 2.0,
      "CooldownSeconds": 60,
      "WarningAudioEnabled": false,
      "ImageCaptureEnabled": true,
      "VideoCaptureEnabled": true
    }
  },
  "Evidence": {
    "RollingBufferSeconds": 30,
    "BufferSegmentSeconds": 1,
    "PreEventSeconds": 10,
    "PostEventSeconds": 20,
    "RootFolder": "%USERPROFILE%\\Documents\\GCam\\Evidence",
    "UploadEnabled": false
  },
  "Warning": {
    "MasterEnabled": true,
    "PersonWav": "assets/person_warning.wav",
    "VehicleWav": "assets/vehicle_warning.wav",
    "LicensePlateWav": "assets/lpd_warning.wav",
    "GarbageWav": "assets/garbage_warning.wav"
  },
  "Sftp": {
    "Host": "",
    "Port": 22,
    "Username": "",
    "Password": "",
    "BaseDirectory": "/upload/gcam"
  },
  "Cloudflare": {
    "DashboardEnabled": true,
    "BindAddress": "0.0.0.0",
    "DashboardPort": 8080,
    "ControlApiKey": "",
    "TunnelEnabled": false,
    "TunnelAutoStart": false,
    "PublicBaseUrl": "",
    "Protocol": "auto",
    "MetricsPort": 20241
  }
}